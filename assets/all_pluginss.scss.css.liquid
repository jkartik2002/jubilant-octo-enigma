/* ===== ajax-cart.scss.liquid - Start ===== */
section.cart-drawer {
  .top-cart-header {
    padding: 15px 48px 10px;
    position: relative;
    {% comment %} TODO undo later {% endcomment %}
    {% comment %} margin-top: 53px; {% endcomment %}

    @media (max-width: 1099px) {
      border-bottom: 1px solid #d8d8d885;
      margin: 0 25px;
      padding: 20px 0 10px;
      {% comment %} margin-top: 53px; {% endcomment %}
    }
  }

  .top-cart-header h2 {
    margin: 0;
    padding: 0;
    color: #2A2A5F;
    text-align: left;
    font-weight: 500;
    font-size: 24px;
    line-height: 40px;
  }
  div.desc {
    color: white;
    text-align: center;
    letter-spacing: 0.29px;
    font-size: 13px;
    margin-top: 3px;
    font-weight: 500;
  }

  span.empty {
    display: inline-block;
    margin-top: 40px;
    font-weight: 500;
    font-size: 32px;
    color: #2A2A5F;
    padding: 0 50px;

    @media (max-width: 1099px) {
      padding: 0 25px;
    }
  }
  div.disclaimer {
    font-size: 14px;
    line-height: 24px;
    color: #2A2A5F;
    padding: 0 50px 20px;
    float: left;

    @media (max-width: 1099px) {
      padding: 20px 0;
    }
  }
  a.cta {
    margin: 0 50px;
    width: calc(100% - 100px);
    margin-top: 0;

    @media (max-width: 1099px) {
      margin: 0 25px;
      width: calc(100% - 50px);
    }
  }

  .total-div {
    font-size: 16px;
    margin: 0 0 5px;
    font-weight: 600;
    display: block;

    span {
      font-weight: 400;
      font-size: 16px;
      line-height: 20px;
      width: 49%;
      display: inline-block;
      color: #2A2A5F;
    }
    span.label {
      text-align: left;
    }
    .float-right {
      text-align: right;
    }
    .calculated {
      font-size: 16px;

      // .free {
      //   color: #59BA47;
      // }
    }
  }

  span.money[data-integration-price-saved="1"] {
    display: inline-block;
  }

  .cart_product_image {
    width: 25%;
    float: left;

    @media (max-width: 1099px) {
      margin-bottom: 40px;
    }

    background: #F9F9F9;

    img {
      mix-blend-mode: multiply !important;
    }
  }

  .cart_product-info.product {
    width: 75%;
    float: left;
    padding-left: 20px;
  }

  .ajaxcart__product_inner {
    float: left;
    width: 100%;
    clear: both;
    position: relative;
  }

  h4.cart-title {
    font-size: 17px;
    color: #2A2A5F;
    font-weight: 500;
    text-align: left;
    line-height: 20px;
  }

  h4.cart-single-price {
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #2A2A5F;
    opacity: .7;
    text-align: left;
    margin: 11px 0;
  }

  h4.cart-price {
    font-size: 14px;
    color: #2A2A5F;
    font-weight: 500;
    padding-left: 14px;
  }

  div.ajax-cart-item__quantity {
    width: 137px;
    height: 40px;
    border: 1px solid #D8D8D8;
    border-radius: 50px;
    text-align: center;
    line-height: 2.6;
    display: inline-block;
    font-weight: 500;
    vertical-align: middle;
    float: left;
  }
  span.js-ajax-minus-cart {
    display: inline-block;
    font-size: 28px;
    text-align: center;
    color: #2A2A5F;
    margin-right: 10px;
    cursor: pointer;
    transition: all .15s ease-in-out;
    float: left;
    line-height: 1.2;
    margin-left: 18px;
    font-weight: 400;
  }

  span.js-ajax-add-cart {
    display: inline-block;
    font-size: 20px;
    border-radius: 50%;
    text-align: center;
    color: #2A2A5F;
    margin-left: 10px;
    cursor: pointer;
    transition: all .15s ease-in-out;
    margin-top: 3px;
    float: right;
    line-height: 1.6;
    margin-right: 18px;
    font-weight: 400;
  }

  .ajaxcart__product-name-wrapper {
    display: -webkit-box;
    display: -moz-box;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;

    -webkit-box-pack: space-between;
    -moz-box-pack: space-between;
    -ms-flex-pack: space-between;
    -webkit-justify-content: space-between;
    justify-content: space-between;

    .middle-col {
      width: 100%;
    }
  }

  .cart_product-info.product.quantity {
    padding: 0;
    margin-top: 16px;
    width: 100%;
  }


  .cart-overlay {
    position: fixed;
    background: #000;
    opacity: 0.8;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    z-index: 11;
  }

  .is-locked .cart-overlay {
    display: block;
  }

  .ajax-cart__modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 40;
    max-width: 575px;
    background: getColor('white', 'default');
    border: 1px solid #e9e9e9;
    padding: 50px 65px;
    opacity: 0;
    visibility: hidden;
    will-change: opacity, visibility;

    &.is-open {
      opacity: 1;
      visibility: visible;
    }
  }

  .ajax-cart__overlay {
    position: fixed;
    z-index: 30;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: getColor('black-40', 'variations');
    opacity: 0;
    visibility: hidden;
    will-change: opacity, visibility;

    &.is-open {
      visibility: visible;
      background-color: #2a2a5f7d;
      opacity: 1;
    }

  }

  .ajax-cart__drawer {
    transition: transform 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: fixed;
    z-index: 999;
    right: -512px;
    top: 0;
    max-width: 512px;
    height: 100%;
    background: #f6f6f6;
    will-change: transform;
    border-left: 1px solid #e9e9e9;
    width: 100%;

    &.is-open {
      transform: translateX(-100%);
    }

  }

  .ajax-cart-modal {
    position: relative;

  }

  .ajax-cart-modal__close {
    position: absolute;
    right: 20px;
    top: 17px;

    svg {
      fill: #555555;
    }
  }

  .note-area {
    padding: 20px 50px 0;
    float: left;
    width: 100%;
    margin: 0;
  }

  .ajax-cart-modal__content {
    padding: 20px;
  }

  .ajax-cart-drawer {
    position: relative;
    height: 100%;
    background: #fff;

    {% comment %} unsticky {% endcomment %}
    @media (max-width: 1099px) {
      overflow: scroll;
    }

    div.gift-wrapper {
      padding: 0;

      div.options {
        padding: 26px 0 12px;
      }
    }
  }

  .ajax-cart-drawer__close {
    position: absolute;
    right: 40px;
    top: 20px;
    cursor: pointer;
    background-color: #FE19F5;
    width: 32px;
    height: 32px;
