            @media (max-width: 1099px) {
              display: none;
            }
          }
          &.center {
            text-align: center;
          }
          &.first {
            width: 40%;
            @media (max-width: 1099px) {
              width: auto;
            }
          }
        }
        span.variant-wrapper {
          display: inline-block;

          @media (min-width: 1100px) {
            display: none !important;
          }

          span.pipe {
            display: inline-block;
            width: 2px;
            height: 18px;
            background-color: #2A2A5F;
            vertical-align: middle;
            margin-left: 11px;
            margin-right: 4px;
          }
          span.swatch-outer {
            display: inline-block;
            width: 24px;
            height: 24px;
            border-radius: 20px;
            margin-left: 4px;
            border: 1px solid white;
            padding: 2px;
            vertical-align: middle;

            &.selected {
              border: 1px solid black;
            }

            div.swatch-inner {
              width: 100%;
              height: 100%;
              border-radius: 20px;

              &.silver {
                background-color: #D8D8D8;
              }
              &.gold {
                background-color: #E4C385;
              }
              &.solid-gold {
                background-color: #E6D598;
              }
            }
          }
        }
        img.tooltip {
          vertical-align: middle;
          width: 16px;
          margin-left: 10px;
        }
        thead {
          td.rxs, td.rxs-inf, td {
            @media (max-width: 1099px) {
              font-size: 18px;
            }
          }
        }
      }
      a.cta {
        display: inline-block;
        font-size: 14px;
        line-height: 18px;
        margin-top: 50px;
        font-weight: 600;

        @media (max-width: 1099px) {
          margin-top: 30px;
        }
      }
      button.show-chart {
        margin-top: 40px;
        background-color: transparent;
        border-radius: 0 !important;
        width: auto;
        height: auto;
        display: inline-block;
        font-weight: 500;
        padding: 0;
        font-size: 14px;
        line-height: 18px;
        color: #2a2a5f;
        border-bottom: 1px solid #2a2a5f;

        &.opened {
          margin-top: 60px;
        }
      }
    }
    div.carousel {
      padding: 0 3vw 60px;

      @media (max-width: 1099px) {
        padding: 0 18px;
        margin-top: 30px;
      }

      div.carousel-cell {
        width: 100%;
        padding: 0 5px;
      }
      video.video {
        width: 100%;
        height: 32vw;
        object-fit: cover;
      }
      img, video.video {
        @media (max-width: 1099px) {
          width: 100%;
          height: 68vw;
          object-fit: cover;
        }
      }
      div.caption {
        text-align: center;
        margin-top: 15px;
        font-size: 16px;
        color: #2A2A5F;
      }
      .flickity-page-dots {
        bottom: 25px;
        width: calc(100% - 120px);

        @media (max-width: 1099px) {
          max-width: 300px;
          left: 0;
          right: 0;
          margin: 0 auto;
          bottom: -20px;
        }

        li.dot {
          border: 1px solid #FE19F5;
          background-color: transparent;
          opacity: 1;
          margin: 3px 8px;

          @media (max-width: 1099px) {
            width: 5px;
            height: 5px;
            margin: 0 4px;
          }

          &.is-selected {
            background-color: #FE19F5;
          }
        }
      }
      button.flickity-button {
        background-color: transparent;
        background-repeat: no-repeat;
        background-size: 14px;
        background-position-x: 17px;
        background-position-y: 14px;
        top: 42%;

        @media (max-width: 1099px) {
          background-size: 12px;
          background-position-x: 14px;
          padding: 0;
        }

        &:focus, &:active {
          outline: none;
          box-shadow: none;
        }
        svg {
          display: none;
        }
        &.previous {
          left: -10px;
          background-image: url("https://cdn.shopify.com/s/files/1/0072/8455/5834/files/arrow-left.svg");

          @media (max-width: 1099px) {
            left: -14px;
          }
        }
        &.next {
          right: -10px;
          background-image: url("https://cdn.shopify.com/s/files/1/0072/8455/5834/files/arrow-right.svg");

          @media (max-width: 1099px) {
            right: -18px;
          }
        }
      }
    }
  }
}

