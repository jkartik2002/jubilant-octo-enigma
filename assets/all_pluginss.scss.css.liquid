section.bracelet-guide--thought-starters {
  padding: 50px 6vw;
  background-color: #d2fdedc2;
  position: relative;

  @media (max-width: 1099px) {
    padding: 40px 24px 150px;
  }

  h2.title {
    text-align: left;
    margin-bottom: 15px;

    @media (max-width: 1099px) {
      text-align: center;
      margin-bottom: 10px;
    }
  }
  div.desc {
    @media (max-width: 1099px) {
      text-align: center;
    }
    &.right {
      position: absolute;
      right: 6vw;
      top: 110px;
      font-weight: 500;
      font-size: 18px;

      @media (max-width: 1099px) {
        position: initial;
        margin-top: 45px;
      }
    }
  }
  div.image-wrapper {
    background: white;
    position: relative;
    margin-top: 50px;
    padding-right: 8%;

    @media (max-width: 1099px) {
      padding: 34vw 0 27.5vw;
      margin-top: 25px;
    }

  }
  img.checkmark {
    position: absolute;
    width: 2vw;

    &.checkmark-1 {
      left: 6%;
      top: 32%;
      transform: scaleX(-1) rotate(-55deg);

      @media (max-width: 1099px) {
        transform: none;
        left: 30%;
        top: 11%;
        width: 5vw;
      }
    }
    &.checkmark-2 {
      left: 33%;
      top: 16%;
      transform: rotate(-8deg);

      @media (max-width: 1099px) {
        transform: none;
        left: 57%;
        top: 28%;
        width: 6vw;
      }
    }
    &.checkmark-3 {
      left: 64%;
      top: 61%;
      transform: rotate(95deg);

      @media (max-width: 1099px) {
        transform: none;
        left: 15%;
        top: 56%;
        width: 5.2vw;
      }
    }
    &.checkmark-4 {
      left: 86%;
      top: 47%;
      transform: rotate(130deg);

      @media (max-width: 1099px) {
        transform: none;
        left: 78%;
        top: 69%;
        width: 7vw;
      }
    }
    &.checkmark-5 {
      width: 36px;
      left: 17%;
      bottom: -3%;

      @media (max-width: 1099px) {
        transform: rotate(-80deg);
        left: 46%;
        bottom: -6%;
      }
    }
  }
  div.desc.floating {
    position: absolute;
    font-weight: 500;

    @media (max-width: 1099px) {
      font-size: 18px;
    }

    &.desc-1 {
      left: 5%;
      top: 29%;

      @media (max-width: 1200px) {
        top: 28%;
      }
      @media (max-width: 1099px) {
        top: 6%;
        left: 12%;
      }
    }
    &.desc-2 {
      left: 30%;
      top: 12%;

      @media (max-width: 1200px) {
        top: 11%;
      }
      @media (max-width: 1099px) {
        top: 82%;
        left: 7%;
        max-width: 102px;
        text-align: left;
      }
    }
    &.desc-3 {
      left: 68%;
      top: 70%;

      @media (max-width: 1200px) {
        top: 69%;
      }
      @media (max-width: 1099px) {
        top: 79%;
        left: 65%;
        max-width: 95px;
        text-align: left;
      }
    }
    &.desc-4 {
      left: 86%;
      top: 59%;

      @media (max-width: 1200px) {
        top: 58%;
      }
      @media (max-width: 1099px) {
        top: 20%;
        left: 58%;
        max-width: 100px;
        text-align: left;
      }
    }
    &.desc-5 {
      left: 20%;
      bottom: 1%;

      @media (max-width: 1200px) {
        left: 21%;
        bottom: 2%;
      }
      @media (max-width: 1099px) {
        left: 59%;
        bottom: -7%;
      }
    }
  }
  img.floating-image {
    position: absolute;
    width: 24vw;
    left: 0;
    bottom: -20vw;

    @media (max-width: 1099px) {
      width: 275px;
      bottom: -100px;
    }
  }
}

