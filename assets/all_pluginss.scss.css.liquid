            margin: 10px auto 15px;
          }
        }
      }
    }
  }

  // Dropdown menu
  #gift-guide-page {
    $color:#2A2A5F;
    $timing:.3s;

    .sub-menu-dropdown {
      position: relative;
      display: inline-block;
      max-height: 45px;
      overflow: hidden;
      cursor: pointer;
      text-align: left;
      width: 100%;
      border: 1px solid #D8D8D8;
      border-radius: 38.5px;
      transition: $timing all ease-in-out;
      margin-bottom: 24px;

      input:focus + label {
        background: #def;
      }
      input {
        width: 1px;
        height: 1px;
        display: inline-block;
        position: absolute;
        opacity: 0.01;
      }
      label {
        border-top: .06em solid #d9d9d9;
        display:block;
        height: 45px;
        line-height: 24px;
        cursor: pointer;
        position: relative;
        transition: $timing color ease-in-out;
        padding: 10px 24px 10px 24px;
        font-size: 16px;
        text-transform: none;

        &:nth-child(2) {
          margin-top: 3em;
          border-top: .06em solid #d9d9d9;
          padding: 10px 24px 10px 24px;
        }
      }
      input:checked + label {
        display:block;
        border-top: none;
        position: absolute;
        top: 0;
        width: 100%;
        margin-bottom: 0;

        &:nth-child(2) {
          margin-top: 0;
          position: relative;
        }
      }

      &::after {
        content:"";
        position: absolute;
        right: 1em;
        top: 1.2em;
        border: .3em solid $color;
        border-color: $color transparent transparent transparent;
        transition: .4s all ease-in-out;
      }
      &.expanded {
        border: .06em solid $color;
        background: #fff;
        border-radius: .25em;
        padding: 0;
        box-shadow: rgba(0, 0, 0, 0.1) 3px 3px 5px 0px;
        max-height:25em;

        label {
          border-top: .06em solid #d9d9d9;
          margin-bottom: 0;

          &:hover {
            color:$color;
          }
        }
        input:checked + label {
          color:$color;
        }

        &::after {
          transform: rotate(-180deg);
          top: 1em;
        }
      }
    }
  }
}

