section.cart-drawer {
  .top-cart-header {
    padding: 15px 48px 10px;
    position: relative;
    {% comment %} TODO undo later {% endcomment %}
    {% comment %} margin-top: 53px; {% endcomment %}

    @media (max-width: 1099px) {
      border-bottom: 1px solid #d8d8d885;
      margin: 0 25px;
      padding: 20px 0 10px;
      {% comment %} margin-top: 53px; {% endcomment %}
    }
  }

  .top-cart-header h2 {
    margin: 0;
    padding: 0;
    color: #2A2A5F;
    text-align: left;
    font-weight: 500;
    font-size: 24px;
    line-height: 40px;
  }
  div.desc {
    color: white;
    text-align: center;
    letter-spacing: 0.29px;
    font-size: 13px;
    margin-top: 3px;
    font-weight: 500;
  }

  span.empty {
    display: inline-block;
    margin-top: 40px;
    font-weight: 500;
    font-size: 32px;
    color: #2A2A5F;
    padding: 0 50px;

    @media (max-width: 1099px) {
      padding: 0 25px;
    }
  }
  div.disclaimer {
    font-size: 14px;
    line-height: 24px;
    color: #2A2A5F;
    padding: 0 50px 20px;
    float: left;

    @media (max-width: 1099px) {
      padding: 20px 0;
    }
  }
  a.cta {
    margin: 0 50px;
    width: calc(100% - 100px);
    margin-top: 0;

    @media (max-width: 1099px) {
      margin: 0 25px;
      width: calc(100% - 50px);
    }
  }

  .total-div {
    font-size: 16px;
    margin: 0 0 5px;
    font-weight: 600;
    display: block;

    span {
      font-weight: 400;
      font-size: 16px;
      line-height: 20px;
      width: 49%;
      display: inline-block;
      color: #2A2A5F;
    }
    span.label {
      text-align: left;
    }
    .float-right {
      text-align: right;
    }
    .calculated {
      font-size: 16px;

      // .free {
      //   color: #59BA47;
      // }
    }
  }

  span.money[data-integration-price-saved="1"] {
    display: inline-block;
  }

  .cart_product_image {
    width: 25%;
    float: left;

    @media (max-width: 1099px) {
      margin-bottom: 40px;
    }

    background: #F9F9F9;

    img {
      mix-blend-mode: multiply !important;
    }
  }

  .cart_product-info.product {
    width: 75%;
    float: left;
    padding-left: 20px;
  }

  .ajaxcart__product_inner {
    float: left;
    width: 100%;
    clear: both;
    position: relative;
  }

  h4.cart-title {
    font-size: 17px;
    color: #2A2A5F;
    font-weight: 500;
    text-align: left;
    line-height: 20px;
  }

  h4.cart-single-price {
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #2A2A5F;
    opacity: .7;
    text-align: left;
    margin: 11px 0;
  }

  h4.cart-price {
    font-size: 14px;
    color: #2A2A5F;
    font-weight: 500;
    padding-left: 14px;
  }

  div.ajax-cart-item__quantity {
    width: 137px;
    height: 40px;
    border: 1px solid #D8D8D8;
    border-radius: 50px;
    text-align: center;
    line-height: 2.6;
    display: inline-block;
    font-weight: 500;
    vertical-align: middle;
    float: left;
  }
  span.js-ajax-minus-cart {
    display: inline-block;
    font-size: 28px;
    text-align: center;
    color: #2A2A5F;
    margin-right: 10px;
    cursor: pointer;
    transition: all .15s ease-in-out;
    float: left;
    line-height: 1.2;
    margin-left: 18px;
    font-weight: 400;
  }

  span.js-ajax-add-cart {
    display: inline-block;
    font-size: 20px;
    border-radius: 50%;
    text-align: center;
    color: #2A2A5F;
    margin-left: 10px;
    cursor: pointer;
    transition: all .15s ease-in-out;
    margin-top: 3px;
    float: right;
    line-height: 1.6;
    margin-right: 18px;
    font-weight: 400;
  }

  .ajaxcart__product-name-wrapper {
    display: -webkit-box;
    display: -moz-box;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;

    -webkit-box-pack: space-between;
    -moz-box-pack: space-between;
    -ms-flex-pack: space-between;
    -webkit-justify-content: space-between;
    justify-content: space-between;

    .middle-col {
      width: 100%;
    }
  }

  .cart_product-info.product.quantity {
    padding: 0;
    margin-top: 16px;
    width: 100%;
  }


  .cart-overlay {
    position: fixed;
    background: #000;
    opacity: 0.8;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    z-index: 11;
  }

  .is-locked .cart-overlay {
    display: block;
  }

  .ajax-cart__modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 40;
    max-width: 575px;
    background: getColor('white', 'default');
    border: 1px solid #e9e9e9;
    padding: 50px 65px;
    opacity: 0;
    visibility: hidden;
    will-change: opacity, visibility;

    &.is-open {
      opacity: 1;
      visibility: visible;
    }
  }

  .ajax-cart__overlay {
    position: fixed;
    z-index: 30;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: getColor('black-40', 'variations');
    opacity: 0;
    visibility: hidden;
    will-change: opacity, visibility;

    &.is-open {
      visibility: visible;
      background-color: #2a2a5f7d;
      opacity: 1;
    }

  }

  .ajax-cart__drawer {
    transition: transform 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: fixed;
    z-index: 999;
    right: -512px;
    top: 0;
    max-width: 512px;
    height: 100%;
    background: #f6f6f6;
    will-change: transform;
    border-left: 1px solid #e9e9e9;
    width: 100%;

    &.is-open {
      transform: translateX(-100%);
    }

  }

  .ajax-cart-modal {
    position: relative;

  }

  .ajax-cart-modal__close {
    position: absolute;
    right: 20px;
    top: 17px;

    svg {
      fill: #555555;
    }
  }

  .note-area {
    padding: 20px 50px 0;
    float: left;
    width: 100%;
    margin: 0;
  }

  .ajax-cart-modal__content {
    padding: 20px;
  }

  .ajax-cart-drawer {
    position: relative;
    height: 100%;
    background: #fff;

    {% comment %} unsticky {% endcomment %}
    @media (max-width: 1099px) {
      overflow: scroll;
    }

    div.gift-wrapper {
      padding: 0;

      div.options {
        padding: 26px 0 12px;
      }
    }
  }

  .ajax-cart-drawer__close {
    position: absolute;
    right: 40px;
    top: 20px;
    cursor: pointer;
    background-color: #FE19F5;
    width: 32px;
    height: 32px;
    border-radius: 20px;
    text-align: center;
    line-height: 1.9;


    @media (max-width: 1099px) {
      top: 25px;
      right: 0;
      width: 22px;
      height: 22px;
      line-height: 0;
    }

    svg {
      width: 16px;
    }
  }

  .ajaxcart__inner {
    {% comment %} TODO undo later {% endcomment %}
    {% comment %} height: calc(100% - 295px); {% endcomment %}
    height: calc(100% - 342px);
    overflow: hidden;
    overflow-y: scroll;
    margin-right: 5px;
    border-bottom: 1px solid #d8d8d882;
    width: 100%;

    &.empty {
      height: 100%;
    }

    @media (max-width: 1099px) {
      {% comment %} TODO undo later {% endcomment %}
      {% comment %} height: calc(100% - 260px); {% endcomment %}
      {% comment %} height: calc(100% - 300px); {% endcomment %}

      {% comment %} unsticky {% endcomment %}
      height: auto;
      overflow: initial;

      padding: 0;

      &.empty {
        height: 100%;
      }
    }

    &::-webkit-scrollbar {
      -webkit-appearance: none;
      background-color: #2a2a5f80;
      border-radius: 10px;
      width: 6px;
    }

    &::-webkit-scrollbar-thumb {
      border-radius: 10px;
      background-color: #2a2a5f !important;
      -webkit-box-shadow: 0 0 1px rgba(255,255,255,.5);
    }
  }

  .ajax-cart-drawer__buttons {
    color: white;
    z-index: 10;
    width: 100%;
    padding: 24px 30px;

    @media (max-width: 1099px) {
      {% comment %} unsticky {% endcomment %}
      {% comment %} position: absolute;
      left: 0;
      bottom: 0; {% endcomment %}
      padding: 20px 25px 25px;
    }

    .button {
      margin: 15px auto 0;
      width: 100%;
      font-weight: bold;
      letter-spacing: 0.2em;
      width: 48%;
      display: inline-block;
      border-radius: 100px !important;
      font-size: 14px !important;
      line-height: 3.1;
      color: #2A2A5F;
      text-align: center;
      height: 44px;
    }
    a.view-bag {
      background: transparent;
      border: 1px solid #2a2a5f84;

      &:hover {
        background-color: #2A2A5F !important;
        color: white !important;
      }
    }
    a.checkout {
      background: #91FCD4;
      border: none;
      float: right;
    }
  }

  a.shop-cta {
    border: 4px solid #009552;
    width: 44%;
    height: 52px;
    color: #009552;
    text-align: center;
    font-size: 12px;
    line-height: 3.7;
    font-weight: bold;
    border-radius: .25rem;
    letter-spacing: 0.96px;
    transition: color 0.1s ease-in,background-color 0.1s ease-in;

    @media (max-width: 1099px) {
      width: 47%;
    }

    &:hover {
      background-color: #009552;
      color: white;
    }

    &.left {
      float: left;
    }
    &.right {
      float: right;
    }
  }

  .ajax-cart-item__single {
    position: relative;
    border-bottom: 1px solid #d8d8d882;
    float: left;
    width: 100%;
    padding: 32px 48px 20px;

    @media (max-width: 1099px) {
      padding: 20px 25px;
    }

    &:last-child {
      // border: none;
    }
  }

  .ajax-cart-item__image {
    width: 100%;
  }

  .ajax-cart-item__remove {
    cursor: pointer;
    display: inline-block;
    margin-left: 24px;
    vertical-align: middle;
    font-weight: 500;
    font-size: 14px;
    color: #2A2A5F;
    border-bottom: 1px solid #2A2A5F;
    line-height: 1.2;
    float: left;
    margin-top: 10px;

    @media (max-width: 1099px) {
      float: right;
      margin-top: 10px;
    }
  }


  @media(max-width: 1099px) {
    .ajax-cart__drawer {
      right: -100%;
      max-width: 100%;
    }
  }
}

div.message-bar {
  width: 100%;
  height: 40px;
  background-color: #D2FDED;
  text-align: center;
  line-height: 2.65;
  font-size: 14px;
  color: #2A2A5F;

  &.klarna {
    background-color: #f0f0f0;
  }

  img {
    width: 12px;
    vertical-align: middle;
    margin-right: 7px;
  }
}

div.you-might-like-container {
  padding: 30px 50px;
  padding-right: 0;
  float: left;
  width: 100%;
  position: relative;

  @media (max-width: 1099px) {
    padding: 25px;
    padding-right: 0;
  }

  h2.title {
    text-align: left;
    font-size: 24px;
    line-height: 40px;
    margin-bottom: 35px;
    color: #2A2A5F;
  }
  div.carousel {
    position: initial;

    div.carousel-cell {
      width: 47%;
      {% comment %} width: 35%; {% endcomment %}
      padding-right: 35px;

      @media (max-width: 1099px) {
        width: 60%;
        padding-right: 32px;
      }

      &:hover {
        a.caption {
          display: block !important;
        }
        div.variant-wrapper {
          display: block !important;
          margin-top: 11px !important;
        }
      }

    }
    div.image__first, div.image__second {
      background: #F9F9F9;

      img {
        mix-blend-mode: multiply !important;
        width: 100%;
      }
    }
    span.title, div.price {
      font-weight: 500;
      line-height: 20px;
      color: #2A2A5F;
      padding: 0;
    }
    span.title {
      font-size: 16px;
      margin: 20px 0 7px;
      {% comment %} min-height: 80px; {% endcomment %}
      {% comment %} overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; {% endcomment %}
    }
    div.price {
      font-size: 14px;
      opacity: .7;
    }
    div.variant-wrapper {
      span.variant-title {
        display: block;
        margin-top: 12px;

        span.line {
          display: none;
        }
      }
    }
    button.cta {
      width: 100%;
      height: 44px;
      background-color: transparent;
      border: 1px solid #2A2A5F;
      color: #2A2A5F;
      letter-spacing: 0.2em;
      font-weight: bold;
      font-size: 14px;
      margin-top: 15px;
    }
    button.flickity-button {
      background-color: transparent;
      background-repeat: no-repeat;
      background-size: 14px;
      background-position-x: 17px;
      background-position-y: 14px;
      top: 40px;

      &:focus {
        box-shadow: none;
      }
      svg {
        display: none;
      }

      &.previous {
        background-image: url("arrow-left.svg?v=1");
        // left: -100px;
        left: auto;
        right: 125px;
      }
      &.next {
        background-image: url("arrow-right.svg?v=1");
        // right: -100px;
        right: 54px;
      }
    }
  }
}