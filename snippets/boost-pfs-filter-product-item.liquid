ice %} {% assign sca_compare_at_price_max = variant.compare_at_price %} {% assign sca_product_available = variant.available %} {% assign sca_product_variantCount = 1 %} {% assign sca_is_first_variant = false%}{% else %},{{variant | json }} {% if sca_price_min >= variant.price %} {% assign sca_price_min = variant.price %} {% assign sca_price = variant.price %}{% endif %} {% if sca_price_max <= variant.price %} {% assign sca_price_max = variant.price %} {% endif %} {% if variant.compare_at_price %} {% if sca_compare_at_price_min==null or sca_compare_at_price_min >= variant.compare_at_price %} {% assign sca_compare_at_price_min = variant.compare_at_price %} {% assign sca_compare_at_price = variant.compare_at_price %} {% endif %} {% if sca_compare_at_price_max==null or sca_compare_at_price_max < variant.compare_at_price %} {% assign sca_compare_at_price_max = variant.compare_at_price %} {% endif %} {% endif %} {% if variant.available == true %} {% assign sca_product_available = true %} {% endif %} {% assign sca_product_variantCount = sca_product_variantCount | plus: 1 %}{% endif %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{%endfor%} ]{% endcapture %}{% if sca_price_min < sca_price_max %}{% assign sca_price_varies = true %}{% else %}{% assign sca_price_varies = false %}{% endif %}{% if sca_compare_at_price_min < sca_compare_at_price_max %}{% assign sca_compare_at_price_varies = true %}{% else %}{% assign sca_compare_at_price_varies = false %}{% endif %}{% if sca_product_variantCount > 1 %}{% assign sca_has_only_default_variant = false %}{% endif %}{% if sca_product_variantCount == sca_product.variants.size %} "variants":{{ sca_product.variants }},{% else %}{%assign sca_product_variants_json = sca_variants_json %} "variants":{{ sca_variants_json }},{% endif %}{% else %} "variants":{{ sca_product_variants_json }},{% endif %} "id": {{sca_product.id}}, "title": {{sca_product.title | json}}, "handle": {{sca_product.handle | json}}, "description": {{sca_product.description | json}}, "published_at": "{{sca_product.published_at | date: "%Y-%m-%dT%H-%M-%S%:z" }}", "created_at": "{{sca_product.created_at | date: "%Y-%m-%dT%H-%M-%S%:z" }}", "vendor": {{sca_product.vendor | json}}, "type": {{sca_product.type | json}}, "tags": {{sca_product.tags | json}}, "price": {{sca_price}}, "price_min": {{sca_price_min}}, "price_max": {{sca_price_max}}, "available": {{sca_product.available}}, "price_varies": {{sca_price_varies}}, "compare_at_price": {{sca_compare_at_price}}, "compare_at_price_min": {{sca_compare_at_price_min}}, "compare_at_price_max": {{sca_compare_at_price_max}}, "compare_at_price_varies": {{sca_compare_at_price_varies}}, "images": {{sca_product.images | json}}, "featured_image": {{sca_product.featured_image | json }}, "options": {{sca_product.options | json}}, "media": {{sca_product.media | json }}, "content": {{sca_product.content | json }}} {% endcapture sca_product_json %}

{%- comment -%} VERSION: 0.0.3 Please do not delete this line. {%- endcomment -%}
{%- comment -%} Variables from sections/collection-template-boost-pfs-filter {%- endcomment -%}
{%- if product_item_type == nil -%}
  	{%- assign product_item_type = 'grid' -%}
{%- endif -%}

{%- comment -%} Product data {%- endcomment -%}
{%- assign product_url = product.url | within: collection -%}

{%- comment -%} Grid Width Class Desktop {%- endcomment -%}
{%- assign grid_width_class_desktop = ' boost-pfs-filter-grid-width-4' -%}
{%- case products_per_row -%}
{%- when 2 -%}
  	{%- assign grid_width_class_desktop = ' boost-pfs-filter-grid-width-2' -%}
{%- when 3 -%}
  	{%- assign grid_width_class_desktop = ' boost-pfs-filter-grid-width-3' -%}
{%- when 4 -%}
  	{%- assign grid_width_class_desktop = ' boost-pfs-filter-grid-width-4' -%}
{%- when 5 -%}
  	{%- assign grid_width_class_desktop = ' boost-pfs-filter-grid-width-5' -%}
{%- when 6 -%}
  	{%- assign grid_width_class_desktop = ' boost-pfs-filter-grid-width-6' -%}
{%- endcase -%}

{%- comment -%} Grid Width Class Mobile {%- endcomment -%}
{%- assign grid_width_class_mobile = ' boost-pfs-filter-grid-width-mb-2' -%}
{%- case products_per_row_mobile -%}
{%- when 1 -%}
  	{%- assign grid_width_class_mobile = ' boost-pfs-filter-grid-width-mb-1' -%}
{%- when 2 -%}
  	{%- assign grid_width_class_mobile = ' boost-pfs-filter-grid-width-mb-2' -%}
{%- when 3 -%}
  	{%- assign grid_width_class_mobile = ' boost-pfs-filter-grid-width-mb-3' -%}
{%- endcase -%}

{%- comment -%} Show label {%- endcomment -%}
{%- assign show_label = false -%}
{%- if show_sale_label or show_sold_out_label or show_label_by_tag -%}
  	{%- assign show_label = true -%}
{%- endif -%}
{%- assign show_all_label_by_tag = false -%}


{%- comment -%} Soldout {%- endcomment -%}
{%- assign sold_out = false -%}
{%- assign sold_out_class = '' -%}
{%- unless product.available -%}
	{%- assign sold_out = true -%}
	{%- assign sold_out_class = ' sold-out' -%}
{%- endunless -%}

{%- capture sold_out_label -%}
{% assign show_product_label_image = section.settings.show_product_label_image %}
{% assign product_label_image_sold_out = section.settings.product_label_image_sold_out %}
{%- if sold_out == true and show_sold_out_label == true -%}
<span class="soldout boost-pfs-filter-label">{% if show_product_label_image %}<img src="{{ product_label_image_sold_out | img_url: 'small' }}" alt="{{ product_label_image_sold_out.alt }}" />{% else %}{{ label_soldout | default: 'Sold Out' }}{% endif %}</span>
{%- endif -%}
{%- endcapture -%}

{%- comment -%} On Sale {%- endcomment -%}
{%- assign on_sale = false -%}
{%- assign sale_class = '' -%}
{%- if sca_compare_at_price > sca_price -%}
	{%- assign on_sale = true -%}
	{%- assign sale_class =  ' on-sale' -%}
{%- endif -%}

{%- capture sale_label -%}
{% unless product.handle contains 'bundle' %}
	{%- if on_sale == true and show_sale_label == true -%}
		{%- if show_sale_percent == true -%}
			{%- assign salePercent = sca_compare_at_price | minus: sca_price | times: 100 | divided_by: sca_compare_at_price -%}
		{%- endif -%}
			{% assign show_product_label_image = section.settings.show_product_label_image %}
		{% assign product_label_image_sale = section.settings.product_label_image_sale %}
		<span class="sale boost-pfs-filter-label">{% if show_product_label_image %}<img src="{{ product_label_image_sale | img_url: 'small' }}" alt="{{ product_label_image_sale.alt }}" />{% else %}{% if show_sale_percent %} {{salePercent}}% {% else %} {{ label_sale | default: 'Sale' }}{% endif %}{% endif %}</span>
	{%- endif -%}
{% endunless %}
{%- endcapture -%}

{%- comment -%} LABEL EXTEND BY TAG: New, Best, Featured {%- endcomment -%}
{%- capture label_by_tag -%}
{%- if show_label_by_tag -%}
	{%- if show_all_label_by_tag == true -%}
		{%- for tag in product.tags -%}
		{%- if tag contains 'pfs:label-' -%}
			{%- assign t = tag | split: 'pfs:label-' -%}
			<span class="boost-pfs-filter-label tag {{ t | handleize }}">{{- t -}}</span>
		{%- endif -%}
		{%- endfor -%}
	{%- else -%}
		{%- assign product_tags = product.tags | reverse -%}
		{%- for tag in product_tags -%}
		{%- if tag contains 'pfs:label-'-%}
			{%- assign t = tag | split: 'pfs:label-' -%}
			<span class="boost-pfs-filter-label tag {{ t | handleize }}">{{- t -}}</span>
			{%- break -%}
		{%- endif -%}
		{%- endfor -%}
	{%- endif -%}
{%- endif -%}
{%- endcapture -%}


{%- comment -%} Swap Image {%- endcomment -%}
{%- assign active_image_swap_class = ' ' -%}
{%- if active_image_swap and product.images[1] -%}
	{%- assign active_image_swap = true -%}
	{%- assign active_image_swap_class = ' has-bc-swap-image' -%}
{%- endif -%}

{%- comment -%} Product Image {%- endcomment -%}
{%- assign img_default_src = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' -%}
{%- assign preview_image = product.featured_media.preview_image -%}
{%- assign data_widths_range = '180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048' -%}
{%- assign data_widths = data_widths_range | split: ', ' -%}
{%- assign image_size = data_widths[2] | append: 'x' -%}
{%- assign data_src_set = '' -%}
{%- assign data_src_set_flip_img = '' -%}
{%- assign data_img_flip = '' -%}

{%- for widths in data_widths -%}
	{%- assign tempx = widths | append: 'x' -%}
	{%- assign tempw = widths | append: 'w' -%}
	{%- assign temp_src_set = preview_image | img_url: tempx | append: ' ' | append: tempw -%}

	{%- if active_image_swap == true -%}
		{%- assign temp_src_set_flip_img = product.images[1] | img_url: tempx | append: ' ' | append: tempw -%}
	{%- endif -%}

	{%- if forloop.last != true %}
		{%- assign temp_src_set = temp_src_set | append: ', ' -%}

		{%- if active_image_swap == true -%}
		{%- assign temp_src_set_flip_img = temp_src_set_flip_img | append: ', ' -%}
		{%- endif -%}
	{%- endif -%}

	{%- assign data_src_set = data_src_set | append:  temp_src_set -%}
	{%- assign data_src_set_flip_img = data_src_set_flip_img | append:  temp_src_set_flip_img -%}
{%- endfor -%}


{%- capture data_img_flip -%}
{%- if active_image_swap == true -%}
  data-img-flip-src="{{- product.images[1] | img_url: image_size -}}"
  data-img-flip-srcset="{{- data_src_set_flip_img -}}"
{%- endif -%}
{%- endcapture -%}


{%- capture data_image_width_height -%}
{%- if equal_height != 'false' -%}
   data-image-width="{{- product.featured_image.width -}}"
   data-image-height="{{- product.featured_image.height -}}"
{%- endif -%}
{%- endcapture -%}

{%- assign padding_top = 100 -%}
{%- unless preview_image == blank -%}
  	{%- assign padding_top = 1 | divided_by: preview_image.aspect_ratio | times: 100 -%}
{%- endunless -%}

{%- comment -%} Vendor {%- endcomment -%}
{%- capture product_vendor -%}
{%- if show_vendor -%}
{% comment %} <p class="boost-pfs-filter-product-item-vendor">{{- product.vendor -}}</p> {% endcomment %}
{%- endif -%}
{%- endcapture -%}

{%- comment -%} Review {%- endcomment -%}
{%- capture product_review -%}
{%- if show_product_review -%}
<span class="shopify-product-reviews-badge" data-id="{{- product.id -}}"></span>
{%- endif -%}
{%- endcapture -%}

{%- comment -%} Price {%- endcomment -%}
{%- capture product_price -%}
{%- if show_price -%}
<p class="boost-pfs-filter-product-item-price">
{%- if on_sale -%}
	<span class="boost-pfs-filter-product-item-sale-price">{{- sca_price | money -}}</span>
	<s>{{- sca_compare_at_price | money -}}</s>
{%- else -%}
  {%- if sca_price_varies -%}
	<span class="boost-pfs-filter-product-item-price-from-text">{{- label_from | default: 'From' -}}</span>
	{%- endif -%}
	<span class="boost-pfs-filter-product-item-regular-price">{{- sca_price | money -}}</span>
{%- endif -%}
</p>
{%- endif -%}
{%- endcapture -%}

{% capture product_promo_line %}
	{% assign promoText = '' %}
	{% for collection in product.collections %}
		{% if collection.metafields.custom_fields["promo_code_text_line"] != blank %}
			{% assign promoText = collection.metafields.custom_fields["promo_code_text_line"] %}
		{% endif %}
	{% endfor %}
	{% if promoText != blank %}
		<div class="promo-text">{{ promoText }}</div>
	{% endif %}
{% endcapture %}

{%- comment -%} Swatch feature {%- endcomment -%}
{%- capture boostProductOptionSwatch -%}
	swatchName: Color;
	optionName: color;
	swatchDisplay: {{ display_item_swatch }};
	swatchType: {{ swatch_color_display_type }};
	,
	swatchName: Size;
	optionName: size;
	swatchDisplay: {{ display_item_swatch_size }};
	swatchType: '';
{%- endcapture -%}
{%- assign boostProductOptions = boostProductOptionSwatch | split:',' -%}

{%- capture product_swatch -%}
{%- for boostProductOptionsItem in boostProductOptions -%}
	{%- assign items = boostProductOptionsItem | split: ';' -%}

	{%- assign swatchName  = items[0] | split: ':' -%}
	{%- assign swatchName  = swatchName[1] | strip -%}

    {%- assign optionName  = items[1] | split: ':' -%}
	{%- assign optionName  = optionName[1] | strip -%}

    {%- assign swatchDisplay  = items[2] | split: ':' -%}
	{%- assign swatchDisplay  = swatchDisplay[1] | strip -%}

    {%- assign swatchType  = items[3] | split: ':' -%}
	{%- assign swatchType  = swatchType[1] | strip -%}

{%- if swatchDisplay == 'true' -%}

	{%- assign swatch_option_name = swatchName -%}
	{%- assign filter_swatch_option_title = swatchName | handleize | replace: '-', '_' -%}
	{%- assign swatch_values_size = product.options_by_name[swatch_option_name].values.size -%}
	{%- assign bg_size = '50x' -%}
	{%- assign swath_limit = 4 -%}
	{%- assign file_extension = 'png' -%}
	{%- assign swatch_data_img = preview_image | img_url: image_size -%}

	{%- if swatch_values_size < swath_limit -%}
		{%- assign swath_limit = swatch_values_size -%}
	{%- endif -%}
	{%- if swatch_values_size > 0 -%}
	<ul class="boost-pfs-filter-item-swatch boost-pfs-filter-item-swatch-{{ filter_swatch_option_title }}">
		{%- for option in product.options -%}
		{%- if option == swatch_option_name -%}

			{%- assign swatch_index = forloop.index0 -%}
			{%- assign swatch_list = '' -%}
			{%- assign swatch_name = '' -%}
			{%- assign count_swatch = 0 -%}

			{%- for variant in product.variants -%}
			{% if count_swatch < swath_limit %}

				{%- capture swatch_name -%}
				{{- variant.options[swatch_index] -}}
				{%- endcapture -%}

				{%- unless swatch_list contains swatch_name -%}
				{%- assign swatch_list = swatch_list | append: swatch_name | append: ';' -%}
				{%- assign count_swatch = count_swatch | plus : 1 -%}
				{%- assign file_name = '' -%}

				{%- case swatchType -%}
					{%- when 'swatch_color_display_type_image_color' -%}
					{%- assign file_name = swatch_name | handleize | append: '.' | append: file_extension -%}
					{%- assign swatch_img_url = filter_swatch_option_title | append: '-' | append: file_name | file_url -%}
					{%- when 'swatch_color_display_type_image_product' -%}
					{%- assign swatch_img_url = preview_image | img_url: bg_size -%}
					{%- if variant.image != null -%}
					{%- assign swatch_img_url = variant.image.src | img_url: bg_size -%}
					{%- endif -%}
					{%- else -%}
					{%- assign swatch_img_url = '' -%}
				{%- endcase -%}

				{%- capture swatch_bg_img -%}
					{%- if swatch_img_url != '' -%}
					background-image: url({{- swatch_img_url -}});
					{%- endif -%}
				{%- endcapture -%}

				{%- capture swatch_bg_color -%}
					background-color: {{- swatch_name -}};
				{%- endcapture -%}

				{%- if variant.image != null -%}
					{%- assign swatch_data_img = variant.image.src | img_url: image_size | append: ' ' | append: data_widths[2] | append: 'w' -%}
				{%- endif -%}

				<li>
					{%- if optionName == 'color' or optionName == 'colour' -%}
						<div class="boost-pfs-product-item-tooltip">{{- swatch_name -}}</div>
						<span tabindex="0" aria-label="{{- swatch_name -}}"
							data-value="{{- swatch_name | handleize -}}"
							style="{{- swatch_bg_img -}} {{- swatch_bg_color -}}"
							data-img="{{- swatch_data_img -}}"></span>
					{%- else -%}
						<a title="{{- swatch_name -}}" class="product-block" data-href="{{ product.url}}?variant={{ variant.id }}" data-title="{{ product.title }}" data-id="{{ product.variants.first.id }}" data-price="{{ product.variants.first.price | money_without_currency }}" data-position="{{ forloop.index }}" data-category="{{ collection.title }}">{{- swatch_name -}}</a>
					{%- endif -%}
				</li>
				{%- endunless -%}

			{% endif %}
			{%- endfor -%}

		{%- endif -%}
		{%- endfor -%}

		{%- if swatch_values_size > 4 -%}
		<li class="boost-pfs-filter-item-swatch-more">
		<a href="{{- product_url -}}#" title="More {{- swatch_option_name -}}">
			+ {{- swatch_values_size | minus : swath_limit -}}
		</a>
		</li>
		{%- endif -%}
	</ul>
	{%- endif -%}
{%- endif -%}

{% endfor %}
{%- endcapture -%}

<div class="boost-pfs-filter-product-item boost-pfs-filter-product-item-{{- product_item_type -}}
          {{- active_image_swap_class -}}
          {{- grid_width_class_desktop -}}
          {{- grid_width_class_mobile -}}
          {{- sold_out_class -}}
          {{- sale_class -}}" {{- data_image_width_height -}}>
	<div class="boost-pfs-filter-product-item-inner">
    <div class="boost-pfs-filter-product-item-image" data-boost-image-loading-animation>
		<a data-href="{{- product_url -}}" class="boost-pfs-filter-product-item-image-link product-click lazyload"
		style="padding-top: {{- padding_top -}}%;" data-title="{{ product.title }}" data-id="{{ product.variants.first.id }}" data-price="{{ product.variants.first.price | money_without_currency }}" data-position="{{ i }}" data-category="{{ category }}">
			<img class="boost-pfs-filter-product-item-main-image lazyload Image--lazyLoad"
			data-src="{{- preview_image | img_url: image_size -}}"
			data-srcset="{{- data_src_set -}}"
			data-widths="[{{ data_widths_range }}]"
			src="{{- img_default_src -}}"
			data-sizes="auto"
			alt="{{- product.title | escape -}}"
			data-
			{{- data_img_flip -}} />

			<span><img style="display:none;" id="secomapp-fg-image-{{ product.id }}" src="{{ "icon-freegift.png" | asset_url }}" alt="Free Gift Icon" class="sca-fg-img-collect"></span>
			<span class="sca-fg-cat-list prod-show-list" style="display:none;" id="secomapp-fg-data-{{ product.id }}"></span>

		</a>

		{% render 'swym-product-view', product: product %}
		<!-- <button class="swym-button swym-add-to-wishlist-view-product product_{{product.id}}" data-swaction="addToWishlist" data-product-id="{{product.id | json}}"></button> -->

		<!-- Swym Wishlist Plus EPI Button-->
		<button data-with-epi="true" class="swym-button swym-add-to-wishlist-view-product product_{{product.id}}" data-swaction="addToWishlist" data-product-id="{{product.id | json}}" data-variant-id="{{product.variants[0].id}}" data-product-url="{{ shop.url }}{{ product.url }}"></button>
		<!-- Swym Wishlist Plus EPI Button-->

		{%- if show_label == true -%}
		<div class="boost-pfs-filter-product-item-label">
			{{- sold_out_label -}}
			{{- sale_label -}}
			{{- label_by_tag -}}
		</div>
		{%- endif -%}

		{% if settings.quickbuy_enabled %}
			<div class="quickview-wrapper hide-mobile">
				<a href="{{- product_url -}}" data-cc-quick-buy="" class="button alt cc-quick-buy-btn">Quick View</a>
			</div>
		{% endif %}

    </div>
		<div class="boost-pfs-filter-product-bottom">
			<div class="boost-pfs-filter-product-bottom-inner">
				<a href="{{- product_url -}}#" class="boost-pfs-filter-product-item-title">
					{% if product.metafields.custom_fields["variant_collection_reference"] != blank %}
						{{ collections[product.metafields.custom_fields["variant_collection_reference"]].title }}
					{% elsif product.metafields.custom_fields["shortened_title"] != blank  %}
						{{ product.metafields.custom_fields["shortened_title"] }}
					{% else %}
						{{ product.title }}
					{% endif %}
				</a>
				{{- product_vendor -}}
				{{- product_review -}}
				{{- product_price -}}
				{{- product_promo_line -}}
				{%- if product_item_type == 'list' -%}
				<p class="boost-pfs-filter-des">{{- product.content | strip_html | truncatewords: 40 -}}</p>
				{%- endif -%}
				{% comment %} {{- product_swatch -}} {% endcomment %}
				{% render 'variant-swatches', product: product, quick_add: quick_add, isCollection: true %}
