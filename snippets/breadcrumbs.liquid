<script>
console.log({{product | json}})
console.log({{product.collections | json}})
</script>
{% if settings.show_breadcrumbs == true %}
    {% unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' %}
        {{ 'ee-breadcrumbs.scss.css' | asset_url | stylesheet_tag }}

        {% assign t = template | split: '.' | first %}
        
        <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
        <ol>
            <li><a href="/" title="Home">Home</a></li>
        {% case t %}
        {% when 'page' %}
            <li>
            <a href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
            </li>
        {% when 'product' %}

            {% if collection.url %}
                <li>
                    {{- collection.title | link_to: collection.url -}}
                </li>
            {% elsif product.collections.size > 0 %}
                {% liquid
                    assign default_crumb = false
                    for collection in product.collections
                        assign title = collection.title | downcase
                        assign pluralTitle = title | append: 's'
                        assign type = product.type | downcase
                        if title == type or pluralTitle == type
                            unless default_crumb
                            assign default_crumb = collection
                            endunless
                        endif
                    endfor
                %}
                {% if default_crumb.title %}
                    <li>
                        {{- default_crumb.title | link_to: default_crumb.url -}}
                    </li>
                {% endif %}
            {% endif %}
              

            
            {% comment %} <li>
            <a href="{{ product.url }}" aria-current="page">                  {% if product.metafields.custom_fields["variant_collection_reference"] != blank %}
                {{ collections[product.metafields.custom_fields["variant_collection_reference"]].title }}
            {% elsif product.metafields.custom_fields["shortened_title"] != blank  %}
                {{ product.metafields.custom_fields["shortened_title"] }}
            {% else %}
                {{ product.title }}
            {% endif %}</a> {% endcomment %}
            </li>
        {% when 'collection' and collection.handle %}
        
            {% if current_tags %}
            <li>{{ collection.title | link_to: collection.url }}</li>
            <li>
                {% capture tag_url %}{{ collection.url }}/{{ current_tags | join: "+"}}{% endcapture %}
                <a href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</a>
            </li>
            {% else %}
            <li>
                <a href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
            </li>
            {% endif %}
        
        {% when 'blog' %}
        
            {% if current_tags %}
            <li>{{ blog.title | link_to: blog.url }}</li>
            <li>
                {% capture tag_url %}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{% endcapture %}
                <a href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</a>
            </li>
            {% else %}
            <li>
                <a href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
            </li>
            {% endif %}
        
        {% when 'article' %}
        
            <li>{{ blog.title | link_to: blog.url }}</li>
            <li>
            <a href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
            </li>
        
        {% else %}
        
            <li aria-current="page">
            <a href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
            </li>
        
        {% endcase %}
        
        </ol>
        </nav>
    {% endunless %}
{% endif %}
