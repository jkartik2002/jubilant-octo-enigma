<section class="gift-guide-section">  
  <style>
  .image-with-text-car-section.nosto_element { padding-left: 0; padding-right: 0; }
  .image-with-text-car-section { padding-top: 40px; padding-bottom: 40px; }
  .image-with-text-item { width: 24%; padding: 0 10px; display: block; }
  .car-image img, .car-image { width: 100%; }
  .image-with-text-car-section .flickity-prev-next-button.previous { left: 20px; }
  .image-with-text-car-section .flickity-prev-next-button.next { right: 20px; }
  .image-with-text-car-section button.flickity-button[disabled] { display: none; }
  .car-content { font-family: futura-pt, sans-serif; font-weight: 500; color: #2a2a5f; line-height: 20px; font-size: 17px; margin-bottom: 8px; padding-top: 10px; }
  .image-with-text-car-section:not(.flickity-enabled) { display:flex; overflow: hidden; }
  .image-with-text-car-section:not(.flickity-enabled) .image-with-text-item { min-width: 22%; }
  @media(max-width:991px) {
    .image-with-text-car-section .flickity-button { width: 35px; height: 35px; }
    .image-with-text-item { width: calc(100% / 3); padding: 0 10px; }
    .image-with-text-car-section:not(.flickity-enabled) .image-with-text-item { min-width: calc(100% / 3); }
  }
  @media(max-width:767px) {
    .image-with-text-car-section .flickity-button { display: none; }
    .image-with-text-car-section { padding-top: 20px; padding-bottom: 20px; }
    .image-with-text-item { width: 45%; padding: 0 10px; }
    .image-with-text-car-section:not(.flickity-enabled) .image-with-text-item { min-width: 40%; }
  }
  @media(max-width:1099px) {
    .image-with-text-car-section .flickity-prev-next-button.previous { left: 20px; }
  }
  </style>
  
    <div class="image-with-text-car-section" data-flickity='{"adaptiveHeight": true, "freeScroll": false, "contain": true, "pageDots": false, "prevNextButtons": true, "cellAlign": "left", "draggable": true}'>
