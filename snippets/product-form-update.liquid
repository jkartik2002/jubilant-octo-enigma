              data-enable-history-state: 'true' %}

              {% if product.metafields.custom_fields["variant_collection_reference"] != blank %}
                <input type="hidden" name="properties[_short_title]" value="{{ collections[product.metafields.custom_fields["variant_collection_reference"]].title }}">
              {% elsif product.metafields.custom_fields["shortened_title"] != blank  %}
