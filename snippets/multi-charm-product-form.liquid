{% assign sca_product = product %}
{% assign sca_product_id_text = "," | append : sca_product.id | append : "," %}
{% assign sca_price = sca_product.price %}
{% assign sca_price_min = sca_product.price_min %}
{% assign sca_price_max = sca_product.price_max %}
{% assign sca_compare_at_price = sca_product.compare_at_price %}
{% assign sca_compare_at_price_min = sca_product.compare_at_price_min %}
{% assign sca_compare_at_price_max = sca_product.compare_at_price_max %}
{% assign sca_product_available = sca_product.available %}
{% assign sca_product_variantCount = sca_product.variants.size %}
{% assign sca_compare_at_price_varies = sca_product.compare_at_price_varies %}
{% assign sca_price_varies = sca_product.price_varies %}
{% assign sca_has_only_default_variant = false %}
{% capture sca_product_variants_json %}{{sca_product.variants | json }}{% endcapture %} 
{% capture sca_product_json %}{ {% if sca_all_gift_products_ids == null or sca_all_gift_products_ids contains sca_product_id_text %}
{% assign sca_product_available = false %}
{% assign sca_product_variantCount = 0 %}
{% assign sca_has_only_default_variant = true %}
{% assign sca_is_first_variant = true %}{% capture sca_variants_json %} [{% for variant in sca_product.variants %}{% unless variant.metafields.secomapp.freegifts %}{% unless variant.title contains '(Freegifts)' %}{% unless variant.title contains '% Off' %}{% unless variant.metafields.shappify_qb.qb_hide == "1" %}{% unless variant.metafields.shappify_bundle.is_bundle == "true" %}{% unless variant.metafields.brodev_scn.hide == "true" %}{% unless variant.metafields.wholesaler2.wholesale %}{% unless variant.metafields.Wholesaler.level %}{% unless variant.title contains '(Wholesale' %}{% if sca_is_first_variant%} {{ variant | json }}{% assign sca_price = variant.price %} {% assign sca_price_min = variant.price %} {% assign sca_price_max = variant.price %} {% assign sca_compare_at_price = variant.compare_at_price %} {% assign sca_compare_at_price_min = variant.compare_at_price %} {% assign sca_compare_at_price_max = variant.compare_at_price %} {% assign sca_product_available = variant.available %} {% assign sca_product_variantCount = 1 %} {% assign sca_is_first_variant = false%}{% else %},{{variant | json }} {% if sca_price_min >= variant.price %} {% assign sca_price_min = variant.price %} {% assign sca_price = variant.price %}{% endif %} {% if sca_price_max <= variant.price %} {% assign sca_price_max = variant.price %} {% endif %} {% if variant.compare_at_price %} {% if sca_compare_at_price_min==null or sca_compare_at_price_min >= variant.compare_at_price %} {% assign sca_compare_at_price_min = variant.compare_at_price %} {% assign sca_compare_at_price = variant.compare_at_price %} {% endif %} {% if sca_compare_at_price_max==null or sca_compare_at_price_max < variant.compare_at_price %} {% assign sca_compare_at_price_max = variant.compare_at_price %} {% endif %} {% endif %} {% if variant.available == true %} {% assign sca_product_available = true %} {% endif %} {% assign sca_product_variantCount = sca_product_variantCount | plus: 1 %}{% endif %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{% endunless %}{%endfor%} ]{% endcapture %}{% if sca_price_min < sca_price_max %}{% assign sca_price_varies = true %}{% else %}{% assign sca_price_varies = false %}{% endif %}{% if sca_compare_at_price_min < sca_compare_at_price_max %}{% assign sca_compare_at_price_varies = true %}{% else %}{% assign sca_compare_at_price_varies = false %}{% endif %}{% if sca_product_variantCount > 1 %}{% assign sca_has_only_default_variant = false %}{% endif %}{% if sca_product_variantCount == sca_product.variants.size %} "variants":{{ sca_product.variants }},{% else %}{%assign sca_product_variants_json = sca_variants_json %} "variants":{{ sca_variants_json }},{% endif %}{% else %} "variants":{{ sca_product_variants_json }},{% endif %} "id": {{sca_product.id}}, "title": {{sca_product.title | json}}, "handle": {{sca_product.handle | json}}, "description": {{sca_product.description | json}}, "published_at": "{{sca_product.published_at | date: "%Y-%m-%dT%H-%M-%S%:z" }}", "created_at": "{{sca_product.created_at | date: "%Y-%m-%dT%H-%M-%S%:z" }}", "vendor": {{sca_product.vendor | json}}, "type": {{sca_product.type | json}}, "tags": {{sca_product.tags | json}}, "price": {{sca_price}}, "price_min": {{sca_price_min}}, "price_max": {{sca_price_max}}, "available": {{sca_product.available}}, "price_varies": {{sca_price_varies}}, "compare_at_price": {{sca_compare_at_price}}, "compare_at_price_min": {{sca_compare_at_price_min}}, "compare_at_price_max": {{sca_compare_at_price_max}}, "compare_at_price_varies": {{sca_compare_at_price_varies}}, "images": {{sca_product.images | json}}, "featured_image": {{sca_product.featured_image | json }}, "options": {{sca_product.options | json}}, "media": {{sca_product.media | json }}, "content": {{sca_product.content | json }}} {% endcapture sca_product_json %}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
{%- assign media_columns_to_show = 1 %}
{%- assign swatch_option_name_lowercase = settings.swatch_option_name | downcase -%}

{%- if section.settings.media_style != 'one-column' and product.media.size > 1 -%}
  {%- if section.settings.media_style == 'two-column' -%}
    {%- assign media_columns_to_show = 2 -%}
    {%- elsif section.settings.media_style == 'three-column' -%}
    {%- assign media_columns_to_show = 3 -%}
  {%- endif -%}
{%- endif -%}

{% style %}
  @media(max-width: 767px){
    .product-area__media .swiper-container:not(.swiper-container-horizontal) {
       padding-bottom: {{ 1 | divided_by: product.media.first.aspect_ratio | times: 100 }}%;
    }
  }
{% endstyle %}

<section class="product-template {% if product.handle == 'giftcard' %}giftcard-page{% endif %}">
  <div class="product-area
        {% if product.media.size == 1 %}product-area--loner{% endif %}
        {% unless section.settings.full_width or is_featured_product %} product-area--restrict-width{% endunless %}
        {% if section.settings.media_style == 'one-column' %}product-area--one-col {% if section.settings.full_width %}header-overlap-section{% endif %} {% endif %}
        {% if section.settings.media_style == 'two-column' %}product-area--two-col {% endif %}"
      data-section-type="product-template"
      data-components="tabs"
      data-is-featured-product="{{ is_featured_product }}">
    <style type="text/css">
      {% for media in product.media %}
        @media(max-width:767px){
            .product-area__details__thumbs__thumb-{{ forloop.index }} .rimage-outer-wrapper {
                width: {{ media.preview_image.aspect_ratio | times: 70 | floor }}px;
            }
        }
      {% endfor %}
    </style>

    {% if section.settings.enable_mobile_sticky_cart %}
      <div class="product-area__add-to-cart-xs footer-button-xs" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="1s">
        <button class="button no-hover">{{ 'products.product.add_to_cart' | t }}</button>
      </div>
    {% endif %}

    <div class="product-area__media {% if media_columns_to_show != 1 %}multi-column{% endif %}"
        data-cc-animate data-cc-animate-duration="2s">

      
      <div class="carousel carousel-product-images">
        {% for image in product.images %}
          <div class="carousel-cell">
              {% assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
              <img 
                class="lazyload"
                src="{{ image | img_url: '360x' }}"
                alt="{{ product.title | escape }}"
                data-src="{{ img_url }}"
                data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
                data-aspectratio="{{ section.settings.image-1.aspect_ratio }}"
                data-sizes="auto"
                width="{{ image.width }}"
                height="{{ image.height }}"
                data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
              />
          </div>
        {% endfor %}
      </div>
      <div class="carousel carousel-nav">
        {% for image in product.images %}
          <div class="carousel-cell">
            <div class="image-wrapper">
              {% assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
              <img 
                class="lazyload"
                src="{{ image | img_url: '360x' }}"
                alt="{{ product.title | escape }}"
                data-src="{{ img_url }}"
                data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
                data-aspectratio="{{ section.settings.image-1.aspect_ratio }}"
                data-sizes="auto"
                width="{{ image.width }}"
                height="{{ image.height }}"
                data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
              />
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="product-area__details product-detail">
      <div class="product-area__details__inner {% if section.settings.sticky_product_form == false %}product-area__details__inner--not-sticky{% endif %}">
        
        {% if section.settings.show_type and product.type != blank %}
          {% assign type_empty = false %}
        {% else %}
          {% assign type_empty = true %}
        {% endif %}

        {% if section.settings.show_vendor and product.vendor != blank %}
          {% assign vendor_empty = false %}
        {% else %}
          {% assign vendor_empty = true %}
        {% endif %}

        {%- capture price_html -%}
          <div class="product-area__col product-area__col--price {% if type_empty and vendor_empty %}price-area--no-vendor{% else %}price-area--has-vendor{% endif %}
                {% if current_variant.unit_price_measurement %}price-area--has-unit-price{% else %}price-area--no-unit-price{% endif %}">
            <div id="price-reader" class="price-area" data-cc-animate
                data-cc-animate-delay="0.25s" data-cc-animate-duration="1.5s" data-single-price="{{ current_variant.price }}" {% if current_variant.compare_at_price > current_variant.price %}data-single-was-price="{{ current_variant.compare_at_price }}"{% endif %}>
              {% if product != blank %}
                {% if current_variant.compare_at_price > current_variant.price %}
                  <span class="was-price theme-money">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</span>
                {% endif %}
                <div id="product-price" class="price theme-money">{{ current_variant.price | money_without_trailing_zeros }}</div>

                {% render 'unit-price', variant: current_variant %}
              {% else %}
                <span class="was-price">{{ 2999 | money_without_trailing_zeros }}</span>
                <div class="price">{{ 1999 | money_without_trailing_zeros }}</div>
              {% endif %}
            </div>
          </div>
          
        {%- endcapture -%}

        <div class="product-area__details__header above-media-{{ section.settings.title_above_image }}" data-cc-animate>
          {% if type_empty == false or vendor_empty == false %}
            <div class="product-area__row" data-cc-animate data-cc-animate-delay="0.2s" data-cc-animate-duration="1.5s">
              <div class="product-area__col">
                <div class="product-detail__detail product-detail__brandrow vendor align-left">
                  {% if section.settings.show_vendor %}
                    {% assign product_vendor_handle = product.vendor | handle %}
                    {% if collections[product_vendor_handle].handle == product_vendor_handle %}
                      {% assign vendor_url = collections[product_vendor_handle].url %}
                    {% else %}
                      {% assign vendor_url = product.vendor | url_for_vendor %}
                    {% endif %}
                    <span class="brand">
                      <a data-cc-animate-click href="{{ vendor_url }}">{{ product.vendor }}</a>
                    </span>
                  {% endif %}

                  {% if section.settings.show_type %}
                    {% assign product_type_handle = product.type | handle %}
                    {% if collections[product_type_handle].handle == product_type_handle %}
                      {% assign type_url = collections[product_type_handle].url %}
                    {% else %}
                      {% assign type_url = product.type | url_for_type %}
                    {% endif %}

                    {% if product.type != blank %}
                      {% if vendor_url != blank %}<span class="brand-bullet">&bull;</span>{% endif %}

                      <span class="type">
                        <a data-cc-animate-click href="{{ type_url }}">
                          {{ product.type }}
                        </a>
                      </span>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}

          <div class="product-area__row">
            <div class="product-area__col product-area__col--title">
              <div style="position:relative;">
                

              {% if is_featured_product %}
                <a data-cc-animate-click class="product-area__details__title h2" href="{{ product.url }}" data-cc-animate
                  data-cc-animate-delay="0.1s" data-cc-animate-duration="1.5s">
                  {% if product != blank %}
                    {% if product.metafields.custom_fields["variant_collection_reference"] != blank %}
                      {{ collections[product.metafields.custom_fields["variant_collection_reference"]].title }}
                    {% elsif product.metafields.custom_fields["shortened_title"] != blank  %}
                      {{ product.metafields.custom_fields["shortened_title"] }}
                    {% else %}
                      {{ product.title }}
                    {% endif %}
                  {% else %}
                    {{ 'onboarding.product.title' | t }}
                  {% endif %}
                </a>
              {% else %}
                <h1 class="product-area__details__title h2" data-cc-animate
                    data-cc-animate-delay="0.1s" data-cc-animate-duration="1.5s">
                  {% if product.metafields.custom_fields["variant_collection_reference"] != blank %}
                    {{ collections[product.metafields.custom_fields["variant_collection_reference"]].title }}
                  {% elsif product.metafields.custom_fields["shortened_title"] != blank  %}
                    {{ product.metafields.custom_fields["shortened_title"] }}
                  {% else %}
                    {{ product.title }}
                  {% endif %}
                </h1>
              {% endif %}
              <div name="secomapp-fg-image-{{ product.id }}" style="display: none;">{{ "icon-freegift.png" | asset_url | img_tag: "FG icon", "sca-fg-img-collect" }}</div></div>

              {% if settings.enable_reviews %}
                <div data-cc-animate data-cc-animate-delay="0.1s" data-cc-animate-duration="1.5s">
                  <span class="shopify-product-reviews-badge" data-cc-animate
                        data-cc-animate-delay="2.5s" data-cc-animate-duration="1.5s" data-id="{{ product.id }}"></span>
                </div>
              {% endif %}
            </div>
            {% if type_empty == false or vendor_empty == false %}
              <div class="product-area__col product-area__col--price">
              </div>
            {% else %}
              {% comment %} {{ price_html }} {% endcomment %}
              <!-- insert Heart here -->
            {% endif %}
          </div>
        </div>

        <div class="product-detail__form">
          {{ price_html }}<br/>
            {% if settings.enable_reviews %}
              <span class="stamped-product-reviews-badge stamped-main-badge" onclick="openReviews(this);" data-id="{{ product.id }}" data-product-sku="{{ product.handle }}" data-product-type="{{product.type}}" data-product-title="{{product.title}}" style="display: inline-block;">{{ product.metafields.stamped.badge }}</span>
            {% endif %}
           {% unless product.tags contains 'no-afterpay' %}
            {% assign priceafterchk = product.selected_or_first_available_variant.price %}
            {% if priceafterchk > 3500 %}
              {% assign orPay = product.selected_or_first_available_variant.price | divided_by: 4 | money %}
              <div class="or-pay vvv">
                4 payments of <span>{{ orPay }}</span> with Afterpay & more
              </div>
              {% comment %} 4 interest-free payments of {{ orPay }} with <img alt="Klarna Logo" class="klarna-logo" src="{{ 'klarna.png' | asset_img_url: '300x' }}">.Learn More {% endcomment %}
            {% else %}
              <div class="orpay-static-msg">4 payments avail for orders above $35</div>
            {% endif %}
          {% endunless %}

          {% assign promoText = '' %}
          {% assign flag = true %}
            {% assign currentDate = 'now' | date: "%Y-%m-%d %H:%M" %}
            {% for collection in product.collections %}
            
              {% if settings.end_date != blank and settings.start_date != blank %}
                {% if settings.end_date >= currentDate and settings.start_date <= currentDate %}
                  {% for collection2 in settings.collections_list %}
                    {% if flag and collection.handle == collection2.handle %}
                      {% if collection.metafields.custom_fields[settings.metafield_key] != blank %}
                        {% assign promoText = collection.metafields.custom_fields[settings.metafield_key] %}
                        {% assign flag = false %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
              {% if settings.end_date2 != blank and settings.start_date2 != blank %}
                {% if settings.end_date2 >= currentDate and settings.start_date2 <= currentDate %}
                  {% for collection2 in settings.collections_list2 %}
                    {% if flag and collection.handle == collection2.handle %}
                      {% if collection.metafields.custom_fields[settings.metafield_key2] != blank %}
                        {% assign promoText = collection.metafields.custom_fields[settings.metafield_key2] %}
                        {% assign flag = false %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
              {% if settings.end_date3 != blank and settings.start_date3 != blank %}
                {% if settings.end_date3 >= currentDate and settings.start_date3 <= currentDate %}
                  {% for collection3 in settings.collections_list3 %}
                    {% if flag and collection.handle == collection3.handle %}
                      {% if collection.metafields.custom_fields[settings.metafield_key3] != blank %}
                        {% assign promoText = collection.metafields.custom_fields[settings.metafield_key3] %}
                        {% assign flag = false %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
              {% if settings.end_date4 != blank and settings.start_date4 != blank %}
                {% if settings.end_date4 >= currentDate and settings.start_date4 <= currentDate %}
                  {% for collection4 in settings.collections_list4 %}
                    {% if flag and collection.handle == collection4.handle %}
                      {% if collection.metafields.custom_fields[settings.metafield_key4] != blank %}
                        {% assign promoText = collection.metafields.custom_fields[settings.metafield_key4] %}
                        {% assign flag = false %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
              
              {% if flag and collection.metafields.custom_fields["promo_code_text_line"] != blank %}
                {% assign promoText = collection.metafields.custom_fields["promo_code_text_line"] %}
              {% endif %}
            {% endfor %}
          {% if promoText != blank %}
            <div class="promo-text product">{{ promoText }}</div>
          {% endif %}
  
          {% if product.metafields.custom_fields["variant_collection_reference"] != blank %}
            {% assign collection1 = collections[product.metafields.custom_fields["variant_collection_reference"]] %}
  
            {% assign firstVariantTitle = '' %}
            {% for collection in product.collections %}
              {% if product.metafields.custom_fields["variant_title"] != blank %}
                {% assign firstVariantTitle = product.metafields.custom_fields["variant_title"] %}
              {% elsif collection.title contains 'Solid Gold' %}
                {% assign firstVariantTitle = 'Solid Gold' %}
              {% elsif collection.title contains 'Gold Vermeil' %}
                {% assign firstVariantTitle = 'Gold Vermeil' %}
              {% elsif collection.title contains 'Sterling Silver' %}
              {% assign firstVariantTitle = 'Sterling Silver' %}
               {% elsif collection.title contains 'Silver Bundles' %}
                {% assign firstVariantTitle = 'Solid Silver' %}
              {% elsif product.title contains 'Solid Rose Gold' %}
                {% assign firstVariantTitle = 'Solid Rose Gold' %}
              {% elsif product.title contains 'Rose Gold' %}
                {% assign firstVariantTitle = 'Rose Gold' %}
              {% endif %}
            {% endfor %}
  
            <div class="variant-wrapper no-js {% if collection1.products.size > 6 %}long-list{% endif %}">
              {% for variant in collection1.products %}
                {% unless product.tags contains "no-swatch" or product.tags contains "no-swatches" %}
                  {% unless variant.metafields.secomapp.freegifts %}
                    {% unless variant.title contains '% off)' %}
        
        
                      {% assign collectionClass = '' %}
                      {% assign variantTitle = '' %}
                      {% for collection in variant.collections %}
                        {% if collection.title contains 'Solid Gold' %}
                          {% assign collectionClass = 'solid-gold' %}
                          {% assign variantTitle = 'Solid Gold' %}
                        {% elsif collection.title contains 'Gold Vermeil' %}
                          {% assign collectionClass = 'gold-vermeil' %}
                          {% assign variantTitle = 'Gold Vermeil' %}
                        {% elsif collection.title contains 'White' %}
                          {% assign collectionClass = 'white' %}
                          {% assign variantTitle = 'White' %}
                        {% elsif collection.title contains 'Sterling Silver' %}
                          {% capture collectionClass %}silver {{ collection.handle }}{% endcapture %}
                          {% assign variantTitle = 'Sterling Silver' %}
                        {% elsif collection.title contains 'Silver Bundles' %}
                          {% assign collectionClass = 'silver' %}
                          {% assign variantTitle = 'Solid Silver' %}
                        {% elsif variant.title contains 'Solid Rose Gold' %}
                          {% assign collectionClass = 'solid-rose-gold' %}
                          {% assign variantTitle = 'Solid Rose Gold' %}
                        {% elsif variant.title contains 'Rose Gold' %}
                          {% assign collectionClass = 'rose-gold' %}
                          {% assign variantTitle = 'Rose Gold' %}
                        {% endif %}
                      {% endfor %}
        
                      {% if variant.metafields.custom_fields["variant_title"] != blank  %}
                        {% assign variantTitle = variant.metafields.custom_fields["variant_title"]  %}
                      {% endif %}
        
                      <div class="variant no-js {% if product.handle == variant.handle %}selected{% endif %}">
                        <a href="{{ variant.url }}">
                          {% if variant.tags contains 'two-tone-gold-silver' or variant.tags contains 'two-tone-silver-gold' %}
                            {% if variant.tags contains 'two-tone-gold-silver' %}
                              {% assign ptag = 'two-tone-gold-silver' %}
                            {% elsif variant.tags contains 'two-tone-silver-gold' %}
                              {% assign ptag = 'two-tone-silver-gold' %}
                            {% endif %}
                            <div class="variant-inner 22 {{ collectionClass }} two-tone {{ ptag }}" {% if variant.metafields.custom_fields["variant_swatch_color_code"] != blank %}style="background-color: {{ variant.metafields.custom_fields["variant_swatch_color_code"] }};"{% endif %}>
                              <span class="left-side"></span>
                              <span class="right-side"></span>
                            </div>
                          {% else %}
                            <div class="variant-inner 33 {{ collectionClass }}" {% if variant.metafields.custom_fields["variant_swatch_color_code"] != blank %}style="background-color: {{ variant.metafields.custom_fields["variant_swatch_color_code"] }};"{% endif %}></div>
                          {% endif %}
                        </a>
                       </div>
        
                    {% endunless %}
                  {% endunless %}
                {% endunless %}
              {% endfor  %}
  
              <span class="variant-title"><span class="line">|</span>{{ firstVariantTitle }}</span>
            </div>
          <!-- non collection preferences code start -->
          {% else %}
            {% assign firstVariantTitle = '' %}
            {% for collection in product.collections %}
              {% if product.metafields.custom_fields["variant_title"] != blank %}
                {% assign firstVariantTitle = product.metafields.custom_fields["variant_title"] %}
              {% elsif collection.title contains 'Solid Gold' %}
                {% assign firstVariantTitle = 'Solid Gold' %}
              {% elsif collection.title contains 'Gold Vermeil' %}
                {% assign firstVariantTitle = 'Gold Vermeil' %}
              {% elsif collection.title contains 'Sterling Silver' %}
              {% assign firstVariantTitle = 'Sterling Silver' %}
               {% elsif collection.title contains 'Silver Bundles' %}
                {% assign firstVariantTitle = 'Solid Silver' %}
              {% elsif product.title contains 'Solid Rose Gold' %}
                {% assign firstVariantTitle = 'Solid Rose Gold' %}
              {% elsif product.title contains 'Rose Gold' %}
                {% assign firstVariantTitle = 'Rose Gold' %}
              {% endif %}
            {% endfor %}
            <div class="variant-wrapper no-js">
              {% unless product.metafields.secomapp.freegifts %}
                {% unless product.tags contains "no-swatch" or product.tags contains "no-swatches" %}
                  {% unless product.title contains '% off)' %}
                    {% assign collectionClass = '' %}
                    {% assign variantTitle = '' %}
                    {% for collection in product.collections %}
                      {% if collection.title contains 'Solid Gold' %}
                        {% assign collectionClass = 'solid-gold' %}
                        {% assign variantTitle = 'Solid Gold' %}
                      {% elsif collection.title contains 'Gold Vermeil' %}
                        {% assign collectionClass = 'gold-vermeil' %}
                        {% assign variantTitle = 'Gold Vermeil' %}
                      {% elsif collection.title contains 'White' %}
                        {% assign collectionClass = 'white' %}
                        {% assign variantTitle = 'White' %}
                      {% elsif collection.title contains 'Sterling Silver' %}
                        {% capture collectionClass %}silver {{ collection.handle }}{% endcapture %}
                        {% assign variantTitle = 'Sterling Silver' %}
                      {% elsif collection.title contains 'Silver Bundles' %}
                        {% assign collectionClass = 'silver' %}
                        {% assign variantTitle = 'Solid Silver' %}
                      {% elsif variant.title contains 'Solid Rose Gold' %}
                        {% assign collectionClass = 'solid-rose-gold' %}
                        {% assign variantTitle = 'Solid Rose Gold' %}
                      {% elsif variant.title contains 'Rose Gold' %}
                        {% assign collectionClass = 'rose-gold' %}
                        {% assign variantTitle = 'Rose Gold' %}
                      {% endif %}
                    {% endfor %}
      
                    {% if product.metafields.custom_fields["variant_title"] != blank  %}
                      {% assign variantTitle = product.metafields.custom_fields["variant_title"]  %}
                    {% endif %}
  
