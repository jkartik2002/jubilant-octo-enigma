<a href="{{ section.settings.url }}">
  <section class="index-text-image" style="background: url({{ section.settings.bg-image | img_url: '2000x' }}); background-size: cover;">
    <div class="wrapper">
      <div class="column left" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
        <div class="desc">{{ section.settings.desc }}</div>
        {% assign img_url = section.settings.logo-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="logo lazyload"
          alt="{{ section.settings.desc | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.logo-1.aspect_ratio }}"
          data-sizes="auto"
          width="105"
          height="26"
          data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
        />
      </div>
      <div class="column right" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s">
        <div class="image-wrapper">
          {% assign img_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
          <img 
            class="main-image lazyload"
            alt="{{ section.settings.desc | escape | strip }}"
            data-src="{{ img_url }}"
            data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
            data-aspectratio="{{ section.settings.image.aspect_ratio }}"
            data-sizes="auto"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          />
          <div class="img-bg"></div>
        </div>
        {% if section.settings.icon-2 != blank %}
          {% assign img_url = section.settings.icon-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
          <img 
            class="floating-icon floating-2 d-block d-lg-none lazyload"
            alt="{{ section.settings.desc | escape | strip }}"
            data-src="{{ img_url }}"
            data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
            data-aspectratio="{{ section.settings.icon-2.aspect_ratio }}"
            data-sizes="auto"
            width="50"
            height="50"
            data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s"
          />
        {% endif %}
      </div>
    </div>

    {% if section.settings.icon-1 != blank %}
      {% assign img_url = section.settings.icon-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="floating-icon floating-1 lazyload"
        alt="{{ section.settings.desc | escape | strip }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.icon-1.aspect_ratio }}"
        data-sizes="auto"
        width="{{ section.settings.icon-1.width }}"
        height="{{ section.settings.icon-1.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
      />
    {% endif %}
    {% if section.settings.icon-2 != blank %}
      {% assign img_url = section.settings.icon-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="floating-icon floating-2 d-none d-lg-block lazyload"
        alt="{{ section.settings.desc | escape | strip }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.icon-2.aspect_ratio }}"
        data-sizes="auto"
        width="{{ section.settings.icon-2.width }}"
        height="{{ section.settings.icon-2.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s"
      />
    {% endif %}
  </section>

  <style>
    @media (max-width: 1099px) {
      section.index-text-image {
        background: url("{{ section.settings.bg-image-xs | img_url: '1100x' }}") !important;
        background-size: cover !important;
      }
    }
  </style>

  <section class="brand-logos">
    <div class="wrapper">
      <div class="column left" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
        {% assign img_url = section.settings.brand-logo-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="lazyload"
          alt="{{ section.settings.desc | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.brand-logo-1.aspect_ratio }}"
          data-sizes="auto"
          width="123"
          height="28"
          data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
        />
      </div>
      <div class="column" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s">
        {% assign img_url = section.settings.brand-logo-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="lazyload"
          alt="{{ section.settings.desc | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.brand-logo-2.aspect_ratio }}"
          data-sizes="auto"
          width="158"
          height="28"
          data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s"
        />
      </div>
      <div class="column right" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".3s">
        {% assign img_url = section.settings.brand-logo-3 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="lazyload"
          alt="{{ section.settings.desc | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.brand-logo-3.aspect_ratio }}"
          data-sizes="auto"
          width="107"
          height="28"
          data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".3s"
        />
      </div>
      <div class="column d-none d-lg-block" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".4s">
        {% assign img_url = section.settings.brand-logo-4 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="lazyload"
          alt="{{ section.settings.desc | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.brand-logo-4.aspect_ratio }}"
          data-sizes="auto"
          width="115"
          height="28"
          data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".4s"
        />
      </div>
      <div class="column d-none d-lg-block" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".5s">
        {% assign img_url = section.settings.brand-logo-5 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="lazyload"
          alt="{{ section.settings.desc | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.brand-logo-5.aspect_ratio }}"
          data-sizes="auto"
          width="81"
          height="28"
          data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".5s"
        />
      </div>
    </div>
  </section>
</a>

