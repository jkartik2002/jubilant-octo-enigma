{% if section.settings.show-section %}
  <section class="bracelet-guide bracelet-guide--chain">
    {% assign img_url = section.settings.image-chain | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="chain lazyload"
      alt="{{ section.settings.text | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-chain.aspect_ratio }}"
      data-sizes="auto"
      style="display: block; width: 100%; height: auto;"
      width="{{ section.settings.image-chain.width }}"
      height="{{ section.settings.image-chain.height }}"
      data-cc-animate="cc-fade-in-up"
      data-cc-animate-delay="0.1s"
    />

    {% assign img_url = section.settings.image-arrow | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="arrow d-none d-lg-bloc lazyload"
      alt="{{ section.settings.text | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-arrow.aspect_ratio }}"
      data-sizes="auto"
      style="display: block; width: 100%; height: auto;"
      width="{{ section.settings.image-arrow.width }}"
      height="{{ section.settings.image-arrow.height }}"
      data-cc-animate="cc-fade-in-up"
      data-cc-animate-delay="0.2s"
    />

     {% assign img_url = section.settings.image-arrow-xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="arrow d-block d-lg-none lazyload"
      alt="{{ section.settings.text | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-arrow-xs.aspect_ratio }}"
      data-sizes="auto"
      style="display: block; width: 100%; height: auto;"
      width="{{ section.settings.image-arrow-xs.width }}"
      height="{{ section.settings.image-arrow-xs.height }}"
      data-cc-animate="cc-fade-in-up"
      data-cc-animate-delay="0.3s"
    />

    <div class="text">{{ section.settings.text }}</div>
  </section>
{% endif %}

{% schema %}
  {
    "name": "Chain",
    "settings": [
      {
        "type": "checkbox",
        "id": "show-section",
        "label": "Show Section?",
        "default": true
      },
      {
        "type": "textarea",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "image_picker",
        "id": "image-chain",
        "label": "Image Chain"
      },
      {
        "type": "image_picker",
        "id": "image-arrow",
        "label": "Image Arrow - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-arrow-xs",
        "label": "Image Arrow - Mobile"
      }
    ]
  }
{% endschema %}