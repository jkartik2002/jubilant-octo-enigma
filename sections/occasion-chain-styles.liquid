      $('.chart-wrapperGroup .chart-wrapper:first-child').addClass('chart-wrapperShow');
    
    $('.swatch-wrapper .swatch-outer').click(function(){
      let thisdata = $(this).attr('data-type');
      $('.rxs').css({'display': 'none'});
      $(`.${thisdata}`).css({'display': 'table-cell'});
    });
        
      var options = {
        cellAlign: 'left',
        contain: true,
        imagesLoaded: true,
        wrapAround: true
      };
