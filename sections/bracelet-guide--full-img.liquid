{% if section.settings.show-section %}
  {% if section.settings.image != blank %}
    {% assign img_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="w-100 d-none d-lg-block lazyload"
      alt="{{ section.settings.title | escape }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image.aspect_ratio }}"
      data-sizes="auto"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
    />
  {% endif %}
  {% if section.settings.image-xs != blank %}
    {% assign img_url = section.settings.image-xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="w-100 d-block d-lg-none lazyload"
      alt="{{ section.settings.title | escape }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-xs.aspect_ratio }}"
      data-sizes="auto"
      width="{{ section.settings.image-xs.width }}"
      height="{{ section.settings.image-xs.height }}"
      data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
    />
  {% endif %}

  <section class="product-image-text bracelet-guide--image-text-3">
    {% if section.settings.title != blank %}
      <h2 class="title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="desc" style="margin-bottom: 0;">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button-url != blank %}
      <div class="text-center">
        <a class="cta" href="{{ section.settings.button-url }}">{{ section.settings.button-text }}</a>
      </div>
    {% endif %}
  </section>
{% endif %}

{% schema %}
  {
    "name": "Full Image and Text",
    "settings": [
      {
        "type": "checkbox",
        "id": "show-section",
        "label": "Show Section?",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-xs",
        "label": "Image - Mobile"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Need guidance on where to start?"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "Book an appointment here."
      },
      {
        "type": "text",
        "id": "button-text",
        "label": "Button Text",
        "default": "BOOK NOW"
      },
      {
        "type": "url",
        "id": "button-url",
        "label": "Button URL"
      }
    ]
  }
{% endschema %}