<style type="text/css">
  {% if section.settings.logo != blank %}
    .logo img { width: {{ section.settings.mobile_logo_width | escape }}px; }
    @media(min-width:768px){
    .logo img { width: {{ section.settings.desktop_logo_width | escape }}px; }
    }
  {% else %}
    {%- assign logo_font_size_mobile = section.settings.mobile_logo_width | divided_by: 6 | round -%}
    {%- assign logo_font_size_desktop = section.settings.desktop_logo_width | divided_by: 6 | round -%}
    .logo { font-size: {{ logo_font_size_mobile }}px; }
    @media(min-width:768px){
      .logo { font-size: {{ logo_font_size_desktop }}px; }
    }
  {% endif %}

</style>

{% comment %} A hidden form to handle when the checkout button is pressed on the add to cart popup {% endcomment %}
<form action="{{ routes.cart_url }}" method="post" id="cc-checkout-form">
</form>

{% if template == 'gift_card' %}

  {% comment %} Gift card template logo {% endcomment %}
  <div itemscope itemtype="http://schema.org/Organization">
    <meta itemprop="name" content="{{ shop.name }}">
    <a data-cc-animate-click class="logo" href="{{ shop.url }}" itemprop="url">
      {% if section.settings.logo != blank %}
        {% assign double_logo_width = section.settings.logo_width | default: 250 | times: 2 %}
        {% capture img_size %}{% if double_logo_width > 2048 %}2048{% else %}{{ double_logo_width }}{% endif %}x{% endcapture %}
        <img src="{{ section.settings.logo | img_url: img_size }}" alt="{{ shop.name | escape }}" itemprop="logo" />
      {% else %}
        {{ shop.name | escape }}
      {% endif %}
    </a>
  </div>

{% else %}
  {% assign featured_links = section.settings.nav_featured_link | split: ', ' %}

  {% capture logo_html %}
  <a data-cc-animate-click data-cc-animate class="logo {% if section.settings.alt_logo != blank %}logo--has-alt-logo{% endif %}" href="{{ routes.root_url }}"
     itemprop="url">

    {% if template == 'index' %}
      <div class="logo logo-h1">
    {% endif %}

    <meta itemprop="name" content="{{ shop.name }}">
    {% if section.settings.logo != blank %}
      {% assign double_logo_width = section.settings.logo_width | default: 250 | times: 2 %}
      {% capture img_size %}{% if double_logo_width > 2048 %}2048{% else %}{{ double_logo_width }}{% endif %}x{% endcapture %}
      <img src="{{ 'logo-new.svg' | asset_url }}" alt="{{ shop.name | escape }}" itemprop="logo"
           width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}"/>

      {% if section.settings.alt_logo != blank %}
      <span class="alt-logo">
        <img src="{{ section.settings.alt_logo | img_url: img_size }}" alt="{{ shop.name | escape }}" itemprop="logo"
             width="{{ section.settings.alt_logo.width }}" height="{{ section.settings.alt_logo.height }}"/>
      </span>
      {% endif %}
    {% else %}
      {{ shop.name | escape }}
    {% endif %}

    {% if template == 'index' %}
      </div>
    {% endif %}
  </a>
  {% endcapture %}



  {%- capture inline_link_html-%}
    {% if section.settings.desktop_navigation == "inline" %}
      <div class="site-control__inline-links">
        <div class="nav-row multi-level-nav reveal-on-hover" role="navigation" aria-label="{{ 'general.navigation.main_navigation_aria_label' | t | escape }}">
          <div class="tier-1">
            <ul>
              {% for link in linklists[section.settings.menu_linklist].links %}

                {%- assign has_mega_drop_down = true -%}
                {%- if link.links != blank -%}
                  {%- for child_link in link.links -%}
                    {%- if child_link.links == blank -%}
                      {%- assign has_mega_drop_down = false -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- assign has_mega_drop_down = false -%}
                {%- endif -%}

                <li class="{% if link.active %}active{% endif %}{% if link.links != blank %} contains-children{% endif %}{% if has_mega_drop_down %} contains-mega-menu{% endif %}{% if featured_links contains link.title %} featured-link{% endif %} {{ link.title | handle }}">
                  <a {% if link.links == blank %}data-cc-animate-click{% endif %} data-href="{{ link.url }}" class="{% if link.active %}active{% endif %} parent-link {% if link.links != blank %}has-children{% endif %}" {% if link.links != blank %}aria-haspopup="true"{% endif %}>
                    {{ link.title }}
                    {% if link.links != blank %}
                      <!-- <img alt="Down Arrow" width="6" height="4" class="down-arrow" src="{{ 'arrow-down.svg' | asset_url }}"> -->
                    {% endif %}
                  </a>

                  {% if link.links != blank %}

                    {% assign num_ctas = 0 %}
                    {% for block in section.blocks %}
                      {% assign menu_item =  block.settings.menu_item | downcase %}
                      {% assign link_title =  link.title | downcase %}
                      {% if menu_item == link_title %}
                        {% if block.settings.image1 != blank %}
                          {% assign num_ctas = num_ctas | plus: 1 %}
                        {% endif %}
                        {% if block.settings.image2 != blank %}
                          {% assign num_ctas = num_ctas | plus: 1 %}
                        {% endif %}
                          {% if block.settings.image3 != blank %}
                          {% assign num_ctas = num_ctas | plus: 1 %}
                        {% endif %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    <ul {% if has_mega_drop_down %}
                      class="nav-columns
                        nav-columns--count-{{ link.links.size }}
                        {% if link.links.size > 2 %} nav-columns--count-3-or-more {% endif %}
                        {% if link.links.size > 5 %} nav-columns--count-6-or-more {% endif %}
                        nav-columns--cta-count-{{ num_ctas }}
                         {{ link.title | downcase }}"
                      {% else %}
                        class="nav-rows {{ link.title | downcase }}"
                      {% endif %}>

                      {% if link.title == 'SHOP' %}
                        <div class="wrapper">
                          <div class="col col-5th">
                            {% for child_link in link.links %}
                              {% include 'nav-child-links', section: section %}
                            {% endfor %}
                            {% for child_link in linklists['gifts'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %}
                          </div>
                          <div class="col col-5th">
                            {% for child_link in linklists['charms-and-bracelets'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %}
                            {% for child_link in linklists['charm-collections'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %}
                          </div>
                          <div class="col col-5th">
                            {% for child_link in linklists['jewelry'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %}
                            {% comment %} {% for child_link in linklists['jewelry-collections'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %} {% endcomment %}
                          </div>
                          <div class="col col-5th">
                            {% for child_link in linklists['shop-by-region'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %}
                            {% for child_link in linklists['featured-locales'].links %}
                              {% include 'nav-child-links' %}
                            {% endfor %}
                          </div>
                          <div class="col col-5th">
                            {% if section.settings.promo_image != blank %}
                              <a data-href="{{ section.settings.promo_link_url }}" class="promo-link-track" style="width: 100%;" data-category-title="{{ link.title }}" data-title="{{ section.settings.promo_link_text }}">
                                {% assign img_url = section.settings.promo_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
                                <img 
                                  class="promo-img lazyload"
                                  {% if forloop == 1 %}
                                  src="{{ section.settings.promo_image | img_url: '360x' }}"
                                  {% endif %}
                                  alt="{{ section.settings.promo_link_text | escape | strip }}"
                                  data-src="{{ img_url }}"
                                  data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
                                  data-aspectratio="{{ section.settings.promo_image.aspect_ratio }}"
                                  data-sizes="auto"
                                  style="display: block; width: 100%; height: auto;"
                                  width="{{ section.settings.promo_image.width }}"
                                  height="{{ section.settings.promo_image.height }}"
                                />
                              </a>
                            {% endif %}
                            {% if section.settings.promo_link_text != blank %}
                              <a class="promo-link promo-link-track" data-href="{{ section.settings.promo_link_url }}">
                                {{ section.settings.promo_link_text }}
                                <img alt="Right Arrow" width="10" height="16" class="arrow-right" src="{{ 'arrow-right.svg' | asset_url }}">
                              </a>
                            {% endif %}
                          </div>
                        </div>
                      {% else %}
                        {% for child_link in link.links %}
                          {% include 'nav-child-links' %}
                        {% endfor %}
                      {% endif %}

                      {% for block in section.blocks %}
                        {% assign menu_item =  block.settings.menu_item | downcase %}
                        {% assign link_title =  link.title | downcase %}
                        {% if menu_item == link_title %}
                          {% render 'nav-call-to-action', cta: block, render_li: true %}
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    {% endif %}
  {%- endcapture -%}

  <div data-section-type="header" itemscope itemtype="http://schema.org/Organization">
    <div id="site-control" class="site-control inline icons
      {% if section.settings.desktop_navigation == "inline" %}nav-inline-desktop{% endif %}
      {% if section.settings.nav_positioning == "inline" %}scrolls-with-page{% endif %}
      {% if section.settings.nav_positioning == "sticky" or section.settings.nav_positioning == "peek" %}fixed{% endif %}
      {% if section.settings.nav_opacity == "opaque" %}nav-opaque{% endif %}
      has-announcement
      {% if section.settings.use_alt_logo_when_active %}alt-logo-when-active{% else %}main-logo-when-active{% endif %}
      {% if section.settings.desktop_navigation == "inline" %}{% if section.settings.show_locale_selector or section.settings.show_currency_selector %}has-localization{% endif %}{% endif %}
      "
      data-cc-animate
      data-opacity="{% if section.settings.nav_positioning == 'inline' and section.settings.nav_opacity contains 'opaque_on_scroll' %}opaque{% else %}{{ section.settings.nav_opacity }}{% endif %}"
      data-positioning="{{ section.settings.nav_positioning }}"
    >
      <div class="links site-control__inner">
        <a class="menu" href="#page-menu" aria-controls="page-menu" data-modal-nav-toggle aria-label="{{ 'layout.header.menu' | t | escape }}">
          {% render 'icon-menu' %}
          <span class="text-link">{{ 'layout.header.menu' | t }}</span>
        </a>

        <div class="logo-wrapper">
          {{ inline_link_html }}
        </div>

        {{ logo_html }}

        <div class="nav-right-side">
          {% if section.settings.desktop_navigation == "inline" %}
            {% if section.settings.show_locale_selector or section.settings.show_currency_selector %}
              <div class="localization">
                {% render 'localization', input_prefix: 'header' %}
              </div>
            {% endif %}
          {% endif %}

          {% comment %} <a class="cart nav-search"
             href="{{ routes.search_url }}"
             aria-label="{{ 'layout.header.search' | t | escape }}"
             {% comment %} data-modal-toggle="#search-modal" {% endcomment %}
             >
            {% render 'svg-search' %}
            <span class="text-link">{{ 'layout.header.search' | t }}</span>
          </a> {% endcomment %}

          <form action="/search" method="get" role="search" class="search">
            <div class="form-wrapper">
              <input type="search" name="q" id="Search" value="" class="" autocomplete="off">
              <button type="submit" id="desk-search-icon" class="cart nav-search">
                <img width="19" height="19" alt="Search Icon" src="{{ 'search.svg' | asset_url }}">
              </button>
            </div>
          </form>

          {% if section.settings.desktop_navigation == "inline" and shop.customer_accounts_enabled %}
            <a {% unless customer %}data-{% endunless %}href="{{ routes.account_url }}" class="nav-account {% unless customer %}login-track{% endunless %}">
              {% if customer %}
                HELLO, {{ customer.first_name | upcase }}
              {% else %}
                LOG IN
              {% endif %}
            </a>
          {% endif %}

          <a href="#swym-wishlist" class="swym-wishlist d-none d-lg-inline-block">
            <img width="40" height="40" alt="Heart Icon" src="{{ 'wish-2.svg' | asset_url }}">
          </a>

          {% unless template.name ==  'cart' %}
            <a
              id="drawer-opener"
              href="/cart"
              class="cart cart-icon--{{ section.settings.nav_cart_icon }}" aria-label="{{ 'layout.navigation.cart' | t | escape }}">

              <img alt="Suitcase Icon" width="20" height="19" src="{{ 'cart-icon.svg' | asset_url }}">
              <div id="nav-item-count">{{ cart.item_count }}</div>
              <span class="text-link">{{ 'layout.navigation.cart' | t }} {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</span>
            </a>
          {% endunless %}
        </div>
      </div>
    </div>

    <form action="/search" method="get" role="search" class="search lower">
      <div class="form-wrapper lower">
        <input type="search" name="q" id="Search-Mobile" value="" class="" autocomplete="off">
        <button type="submit" id="mob-search-icon" class="cart nav-search">
          <img alt="Search Icon" src="{{ 'search.svg' | asset_url }}">
        </button>
      </div>
    </form>

    <nav id="page-menu" class="theme-modal nav-uses-modal">
      <div class="inner">
        <div class="nav-container">
          <div class="nav-body container growth-area" data-root-nav="true">
            <div class="nav main-nav" role="navigation" aria-label="{{ 'layout.header.menu_aria_label' | t | escape }}">
              <ul>
                {% for link in linklists[section.settings.menu_linklist_xs].links %}
                <li class="{% if link.active %}active{% endif %} {% if featured_links contains link.title %} featured-link{% endif %} {% if link.title == 'GIFTS' or link.title == 'EXPLORE' %}gift-about-wrapper{% endif %}">
                  <a data-href="{{ link.url }}" {% if link.links != blank %}aria-haspopup="true"{% endif %} class="{% if link.title == 'SHOP' %}shop-title{% elsif link.title == 'GIFTS' or link.title == 'EXPLORE' %}gift-about{% endif %} parent-link" data-category-title="{{ link.title }}" data-title="{{ link.title }}">
                    <span>{{ link.title }}</span>
                  </a>

                  {% if link.links != blank %}
                  <ul class="child-list">
                    {%- assign has_mega_drop_down = true -%}
                    {%- if link.links != blank -%}
                      {%- for child_link in link.links -%}
                        {%- if child_link.links == blank -%}
                          {%- assign has_mega_drop_down = false -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- assign has_mega_drop_down = false -%}
                    {%- endif -%}

                    {% if has_mega_drop_down %}
                      {% comment %} Break out the mega menu with titles {% endcomment %}
                      {% for child_link in link.links %}
                        <li class="{% if child_link.active %}active{% endif %} main-nav__mega-title">
                          <a class="childd-childd-link" data-href="{{ child_link.url }}" {% if child_link.links != blank %}aria-haspopup="true"{% endif %} data-category-title="{{ link.title }}" data-title="{{ child_link.title }}">
                            <span>
                              {% if section.settings.nav_featured_link_new == child_link.title or section.settings.nav_featured_link_new_2 == child_link.title %}
                                <span class="new-flag">New!</span>
                              {% endif %}
                              {{ child_link.title }}
                            </span>
                          </a>
                        </li>

                        {% for child_child_link in child_link.links %}
                          <li class="{% if child_child_link.active %}active{% endif %} {% if featured_links contains child_child_link.title %} featured-link{% endif %}">
                            <a data-cc-animate-click href="{{ child_child_link.url }}">
                              <span>
                                {% if section.settings.nav_featured_link_new == child_link.title or section.settings.nav_featured_link_new_2 == child_link.title %}
                                  <span class="new-flag">New!</span>
                                {% endif %}
                                {{ child_child_link.title }}
                              </span>
                            </a>
                          </li>
                        {% endfor %}
                      {% endfor %}

                    {% else %}
                      {% comment %} Render an ordinary child nav {% endcomment %}
                      {% for child_link in link.links %}
                      <li class="{% if child_link.active %}active{% endif %} {% if featured_links contains child_link.title %} featured-link{% endif %}">
                        <a href="{{ child_link.url }}" {% if child_link.links != blank %}aria-haspopup="true"{% else %}data-cc-animate-click{% endif %}>
                          <span>
                            {% if section.settings.nav_featured_link_new == child_link.title or section.settings.nav_featured_link_new_2 == child_link.title %}
                              <span class="new-flag">New!</span>
                            {% endif %}
                            {{ child_link.title }}
                          </span>
                        </a>

                        {% if child_link.links != blank %}
                        <ul class="child-child-list">
                          {% for child_child_link in child_link.links %}
                          <li class="{% if child_child_link.active %}active{% endif %} {% if featured_links contains child_child_link.title %} featured-link{% endif %}">
                            <a data-cc-animate-click href="{{ child_child_link.url }}">
                              <span>
                                {% if section.settings.nav_featured_link_new == child_link.title or section.settings.nav_featured_link_new_2 == child_link.title %}
                                  <span class="new-flag">New!</span>
                                {% endif %}
                                {{ child_child_link.title }}
                              </span>
                            </a>
                          </li>
                          {% endfor %}
                        </ul>
                        {% endif %}
                      </li>
                      {% endfor %}
                    {% endif %}
                  </ul>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
            </div>
          </div>

          <div class="nav-footer-links">
            {% comment %}
            <div class="nav-footer-links__link">
              <a class="search" href="{{ routes.search_url }}" data-modal-toggle="#search-modal">
                {{ 'layout.header.search' | t }} <span class="arr arr--small">{% render 'svg-chevron-right' %}</span>
              </a>
            </div>
            {% endcomment %}

            {% if shop.customer_accounts_enabled %}
              <div class="nav-footer-links__link">
                <a data-href="{{ routes.account_url }}" class="login-track-xs" data-title="{% if customer %}account{% else %}login / register{% endif %}">
                  <img width="32" height="32" alt="Account Icon" src="{{ 'account.svg' | asset_url }}">
                  {% if customer %}
                    ACCOUNT
                  {% else %}
                    LOGIN / REGISTER
                  {% endif %}
                </a>

                <a href="#swym-wishlist" class="swym-wishlist">
                  <img width="40" height="40" alt="Heart Icon" src="{{ 'wish-2.svg' | asset_url }}">
                  WISHLIST
                </a>
              </div>
            {% endif %}

            {% comment %}
              {% render 'social-icons', icon_setting: settings.social_custom_icon, icon_size: 'x40' %}
            {% endcomment %}

            {% if section.settings.show_locale_selector or section.settings.show_currency_selector %}
              <div class="localization">
                {% render 'localization', input_prefix: 'header' %}
              </div>
            {% endif %}
          </div>

          <div class="nav-ctas">
            {% if section.settings.promo_image_xs != blank %}
              <a href="{{ section.settings.promo_link_url }}">
                {% assign img_url = section.settings.promo_image_xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
                <img 
                  class="promo-img lazyload"
                  src="{{ section.settings.promo_image_xs | img_url: '360x' }}"
                  alt="{{ section.settings.promo_link_text | escape | strip }}"
                  data-src="{{ img_url }}"
                  data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
                  data-aspectratio="{{ section.settings.promo_image_xs.aspect_ratio }}"
                  data-sizes="auto"
                  style="width: 100%; height: auto;"
                  width="{{ section.settings.promo_image_xs.width }}"
                  height="{{ section.settings.promo_image_xs.height }}"
                />
              </a>
            {% endif %}
            {% if section.settings.promo_link_text != blank %}
              <a class="promo-link promo-link-track" data-href="{{ section.settings.promo_link_url }}">
                {{ section.settings.promo_link_text }}
                <img width="10" height="16" alt="Right Arrow"  class="arrow-right" src="{{ 'arrow-right.svg' | asset_url }}">
              </a>
            {% endif %}

            {% for block in section.blocks %}
              {% assign nav_item = "_root" %}
              {% if block.settings.menu_item != blank %}
                {% assign nav_item = block.settings.menu_item %}
              {% endif %}

              <div class="nav-ctas__container" data-for-nav-item="{{ nav_item | downcase }}">
                {% render 'nav-call-to-action', cta: block, render_li: false %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </nav>
  </div>

{% endif %}

<div id="nav-blocker" class="nav-blocker"></div>

{% if template.name != 'index' %}
  <style>
    @media (min-width: 1100px) {
      .site-control.nav-inline-desktop .site-control__inner .logo {
        top: -15px;
      }
    }
  </style>
{% endif %}


{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "link_list",
        "id": "menu_linklist",
        "label": "Menu - Desktop",
        "default": "main-menu",
        "info": "To create a mega menu, ensure every link within your menu has child links. [Learn more](https://cleancanvas.co.uk/support/general/mega-menus)"
      },
      {
        "type": "link_list",
        "id": "menu_linklist_xs",
        "label": "Menu - Mobile"
      },
      {
        "type": "text",
        "id": "nav_featured_link",
        "label": "Featured link",
        "info": "Enter the title of a link to highlight it in a different color",
        "default": "Sale"
      },
      {
        "type": "text",
        "id": "nav_large_link",
        "label": "Large link Size",
        "info": "Enter the title of a link to highlight it in a larger size",
        "default": "Bestsellers, Shop All, Ready to Ship"
      },
      {
        "type": "text",
        "id": "nav_featured_link_new",
        "label": "New link 1",
        "info": "Enter the title of a link to highlight it with New Flag, 1 link per input"
      },
      {
        "type": "text",
        "id": "nav_featured_link_new_2",
        "label": "New link 2",
        "info": "Enter the title of a link to highlight it with New Flag, 1 link per input"
      },
      {
        "type": "select",
        "id": "desktop_navigation",
        "label": "Desktop navigation",
        "options": [
          {
            "value": "burger",
            "label": "Show burger menu"
          },
          {
            "value": "inline",
            "label": "Show links"
          }
        ],
        "default": "inline"
      },
      {
        "type": "select",
        "id": "nav_opacity",
        "label": "Navigation background",
        "options": [
          {
            "value": "transparent",
            "label": "Transparent"
          },
          {
            "value": "opaque_on_scroll",
            "label": "Opaque on scroll"
          },
          {
            "value": "opaque_on_scroll_alt",
            "label": "Opaque on scroll showing contrast logo"
          },
          {
            "value": "opaque",
            "label": "Opaque"
          }
        ],
        "default": "transparent"
      },
      {
        "type": "select",
        "id": "nav_positioning",
        "label": "Scroll behavior",
        "options": [
          {
            "value": "sticky",
            "label": "Sticks on scroll"
          },
          {
            "value": "inline",
            "label": "Scrolls with the page"
          },
          {
            "value": "peek",
            "label": "Hides on scroll down"
          }
        ],
        "default": "sticky"
      },

      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Main logo",
        "info": "520 x 200px recommended"
      },
      {
        "type": "image_picker",
        "id": "alt_logo",
        "label": "Contrast logo",
        "info": "Your main logo but in a different color to show over image-heavy sections. This should be the same size as your main logo."
      },
      {
        "type": "checkbox",
        "id": "use_alt_logo_when_active",
        "label": "Show contrast logo on burger menu popup/hovering the navigation bar",
        "default": true
