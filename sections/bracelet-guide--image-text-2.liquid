{% if section.settings.show-section %}
  <section class="product-image-text bracelet-guide--image-text-2 second top">
    <h2 class="title top">{{ section.settings.section-title }}</h2>
    {% comment %} <div class="wrapper">
      <div class="col left">
        <div class="image-wrapper">
          <div class="bg-image"></div>

          {% if section.settings.video-link != blank %}
            <video class="video" playsinline="" autoplay="" muted="" loop="">
              <source src="{{ section.settings.video-link }}">
            </video>
          {% else %}
            <img alt="{{ section.settings.title }}" src="{{ section.settings.image | img_url: '800x' }}">
          {% endif %}
        </div>
      </div>
      <div class="col right">
        <div class="text-wrapper">
          <h2 class="title">{{ section.settings.title }}</h2>
          <div class="desc">{{ section.settings.text }}</div>
        </div>
      </div>
    </div> {% endcomment %}
  </section>

  <section class="product-image-text bracelet-guide--image-text-2 lower third">
    <div class="wrapper">
      <div class="col left">
        <div class="flex-container">
          <div class="text-wrapper">
            <h2 class="title">{{ section.settings.title-2 }}</h2>
            <div class="desc">{{ section.settings.text-2 }}</div>
          </div>
        </div>
      </div>
      <div class="col right">
        <div class="image-wrapper">
          <div class="bg-image"></div>

          {% if section.settings.video-link-2 != blank %}
            <video class="video" playsinline="" autoplay="" muted="" loop="">
              <source src="{{ section.settings.video-link-2 }}">
            </video>
          {% else %}
            {% assign img_url = section.settings.image-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
            <img 
              class="lazyload"
              alt="{{ section.settings.title-2 | escape | strip }}"
              data-src="{{ img_url }}"
              data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
              data-aspectratio="{{ section.settings.image-2.aspect_ratio }}"
              data-sizes="auto"
              style="display: block; width: 100%; height: auto;"
              width="{{ section.settings.image-2.width }}"
              height="{{ section.settings.image-2.height }}"
              data-cc-animate="cc-fade-in-up"
            />
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% assign img_url = 'chain-full.png' | asset_img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
  <img 
    class="w-100 d-none d-lg-block lazyload"
    alt="{{ 'chain guide' | escape | strip }}"
    data-src="{{ img_url }}"
    data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
    data-sizes="auto"
    data-cc-animate="cc-fade-in-up"
  />
  {% assign img_url = 'chain-full-xs.png' | asset_img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
  <img 
    class="w-100 d-block d-lg-none lazyload"
    alt="{{ 'chain guide' | escape | strip }}"
    data-src="{{ img_url }}"
    data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
    data-sizes="auto"
    data-cc-animate="cc-fade-in-up"
  />
{% endif %}

{% schema %}
  {
    "name": "Text and Image 2",
    "settings": [
      {
        "type": "checkbox",
        "id": "show-section",
        "label": "Show Section?",
        "default": true
      },
      {
        "type": "text",
        "id": "section-title",
        "label": "Section Title",
        "default": "Our Charm Bracelets are all about a few unique features"
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Title",
        "default": "Size Comparison"
      },
      {
        "type": "textarea",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "video-link",
        "label": "Video",
        "info": "Vimeo Download URL - takes priority over Image above"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "textarea",
        "id": "title-2",
        "label": "Title 2",
        "default": "Size Comparison"
      },
      {
        "type": "textarea",
        "id": "text-2",
        "label": "Text 2"
      },
      {
        "type": "text",
        "id": "video-link-2",
        "label": "Video 2",
        "info": "Vimeo Download URL - takes priority over Image above"
      },
      {
        "type": "image_picker",
        "id": "image-2",
        "label": "Image 2"
      }
    ],
    "presets": [
      {
        "name": "Text and Image"
      }
    ]
  }
{% endschema %}