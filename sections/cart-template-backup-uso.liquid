<style>
  {% comment %} div.cc-announcement, #ju_bbox, .ju_Con {
    display: none !important;
  } {% endcomment %}
  @media (max-width: 1099px) {
    #shopify-section-header form.search button.nav-search {
      right: 0px !important;
    }
    div#site-control a.logo img {
      left: 0 !important;
    }
  }
</style>

<div class="cart-page central content" data-section-type="cart-template">
  <div class="message-bar klarna d-block d-lg-none">
    <strong>Afterpay</strong> or <strong>Klarna</strong> Available During Checkout
  </div>

  <div class="title-wrapper">
    <h1 data-cc-animate class="h2">
      {{ 'cart.general.title' | t }}
      {% if cart.item_count > 0 %}
        ({{ cart.item_count }})
      {% endif %}
    </h1>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cartform" data-cc-animate>
      <div class="d-block d-lg-none"></div>

      <div class="wrapper">
        <div class="col col-products">
          <ul class="cart-list clearfix">
            {% comment %}
              <li class="item cart-list-header">
                <div class="col-image">{{ 'cart.general.product' | t }}</div>
                <div class="col-notimage">
                    <div class="desc"></div>
                    <div class="item-price">{{ 'cart.general.price' | t }}</div>
                    <div class="quantity-and-remove">{{ 'cart.general.quantity' | t }}</div>
                    <div class="line-total">{{ 'cart.general.total' | t }}</div>
                </div>
              </li>
            {% endcomment %}

            {% for item in cart.items %}
              {% comment %}
                Determining the handle of the collection that was last seen for the 'continue shopping' link.
              {% endcomment %}

              {% if forloop.first %}
                {% capture collection_url %}{{ item.product.collections.first.url }}{% endcapture %}
                {%- if collection_url == empty or collection_url contains '/frontpage' -%}
                  {%- capture collection_url -%}{{ routes.all_products_collection_url }}{%- endcapture -%}
                {%- endif -%}
              {% endif %}

              <li class="item clearfix">
                <div class="col-image">
                  <a
                    data-cc-animate-click
                    class="image"
                    href="{% if item.variant.metafields.secomapp.freegifts %}{{ item.product.url }}{% else %}{{ item.url }}{% endif %}"
                  >
                    {% render 'responsive-image', image: item.image %}
                  </a>
                </div>
                <div class="col-notimage">
                  <div class="desc">
                    <div class="title">
                      <a
                        data-cc-animate-click
                        href="{% if item.variant.metafields.secomapp.freegifts %}{{ item.product.url }}{% else %}{{ item.url }}{% endif %}"
                      >
                        {% if item.product.metafields.custom_fields.variant_collection_reference != blank %}
                          {% assign title = collections[item.product.metafields.custom_fields.variant_collection_reference].title %}
                        {% elsif item.product.metafields.custom_fields.shortened_title != blank %}
                          {% assign title = item.product.metafields.custom_fields.shortened_title %}
                        {% else %}
                          {% assign title = item.product.title %}
                        {% endif %}
                        <span class="product-title">{{ title }}</span>
                        <span class="variant">
                          {%- unless item.product.has_only_default_variant -%}
                            {{-
                              item.variant.title
                              | remove: '/ Default Title'
                              | remove: 'Default Title'
                              | remove: '/ Default'
                              | remove: 'Default'
                              | replace: '(Freegifts)', ''
                            -}}
                          {%- endunless -%}
                        </span>
                      </a>
                    </div>

                    {% comment %} <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_properties" style="display:none !important;"></span> {% endcomment %}
                    {% assign propertySize = item.properties | size %}
                    {% if propertySize > 0 %}
                      <div class="line_properties">
                        {% for p in item.properties %}
                          <div class="property">
                            {% assign first_character_in_key = p.first | truncate: 1, '' %}
                            {% unless p.last == blank or first_character_in_key == '_' or p.first == '_short_title' %}
                              <span class="property_name" data-property-name="{{ p.first }}">{{ p.first }}:</span>
                              {% if p.last contains '/uploads/' %}
                                <a class="property_value" data-property-name="{{ p.last }}" href="{{ p.last }}">
                                  {{- p.last | split: '/' | last -}}
                                </a>
                              {% else %}
                                <span class="property_value" data-property-value="{{ p.last }}">{{ p.last }}</span>
                              {% endif %}
                              <br>
                            {% endunless %}
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}

                    {% comment %}
                      Line Item Properties
                    {% endcomment %}
                    {% comment %}
                      {% if item.properties.size > 0 %}
                      <div class="line-items">
                        {% for p in item.properties %}
                        {% unless p.last == blank %}
                        {{ p.first }}:
                        {% if p.last contains '/uploads/' %}
                        <a data-cc-animate-click href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                        {% else %}
                        {{ p.last }}
                        {% endif %}
                        <br />
                        {% endunless %}
                        {% endfor %}
                      </div>
                      {% endif %}
                    {% endcomment %}

                    {% if item.selling_plan_allocation %}
                      <div class="subscription-description">
                        <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      </div>
                    {% endif %}

                    {% if section.settings.show_backorder_text == true %}
                      {% render 'backorder', variant: item.variant %}
                    {% endif %}

                    <div class="line-price">
                      {{ item.quantity }} @
                      {% if item.product.variants.first.compare_at_price != item.final_line_price
                        and item.product.variants.first.compare_at_price != blank
                      %}
                        {{ item.final_price | money_without_trailing_zeros }}
                        <span class="original-price theme-money" style="font-weight: 600;">
                          {{- item.product.variants.first.compare_at_price | money_without_trailing_zeros -}}
                        </span>
                      {% else %}
                        {{ item.final_price | money_without_trailing_zeros }}
                      {% endif %}
                    </div>

                    <div class="quantity-and-remove">
                      <div class="quantity border-radius-{{ settings.buttons_shape }}">
                        <a
                          class="minus"
                          href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                          aria-label="{{ 'cart.general.decrease' | t | escape }}"
                          ><span>&minus;</span></a
                        >
                        <input
                          {% if item.variant.metafields.secomapp.freegifts %}
                            readonly
                          {% endif %}
                          class="select-on-focus"
                          type="text"
                          size="2"
                          id="updates_{{ item.id }}"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          aria-label="{{ 'cart.general.quantity' | t | escape }}"
                        >
                        <a
                          {% if item.variant.metafields.secomapp.freegifts %}
                            style="display: none !important;"
                          {% endif %}
                          class="plus"
                          href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                          aria-label="{{ 'cart.general.increase' | t | escape }}"
                          ><span>&plus;</span></a
                        >
                      </div>
                    </div>

                    <a class="remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">
                      {{- 'cart.general.remove' | t | escape -}}
                    </a>
                  </div>

                  {% comment %}
                    <div class="item-price">
                      {% if item.original_line_price > item.final_line_price %}
                        <div class="original-price theme-money">{{ item.original_price | money }}</div>
                        <div class="theme-money">{{ item.final_price | money }}</div>
                      {% else %}
                        <div class="theme-money">{{ item.final_price | money }}</div>
                      {% endif %}

                      {% render 'unit-price', variant: item %}

                      {% if item.line_level_discount_allocations.size > 0 %}
                        <ul class="cart-discount-list">
                        {% for discount_allocation in item.line_level_discount_allocations %}
                          <li class="cart-discount">
                            <div class="cart-discount__label">{{ discount_allocation.discount_application.title }}</div>
                            <div class="cart-discount__amount">(-<span class="theme-money">{{ discount_allocation.amount | money }}</span>)</div>
                          </li>
                        {% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  {% endcomment %}

                  {% comment %}
                    <div class="quantity-and-remove">
                      <div class="quantity border-radius-{{ settings.buttons_shape }}">
                        <a class="minus" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.general.decrease' | t | escape }}"><span>&minus;</span></a>
                        <input {% if item.variant.metafields.secomapp.freegifts %}readonly{% endif %}  class="select-on-focus" type="text" size="2" id="updates_{{ item.id }}" name="updates[]" value="{{ item.quantity }}" aria-label="{{ 'cart.general.quantity' | t | escape }}" />
                        <a class="plus" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.general.increase' | t | escape }}"><span>&plus;</span></a>
                      </div>

                      <a class="remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">{{ 'cart.general.remove' | t | escape }}</a>
                    </div>
                  {% endcomment %}

                  {% comment %}
                    <div class="line-total">
                      {% if item.original_line_price != item.final_line_price %}
                        <div class="original-price theme-money">{{ item.original_line_price | money }}</div>
                        <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_total" data-item-key="{{item.key}}" style="display:none !important;"></span>
                        <div class="theme-money">{{ item.final_line_price | money }}</div>
                      {% else %}
                        <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_total" data-item-key="{{item.key}}" style="display:none !important;"></span>
                        <div class="theme-money">{{ item.final_line_price | money }}</div>
                      {% endif %}
                    </div>
                  {% endcomment %}
                  <div class="line-total">
                    <div class="theme-money">{{ item.final_line_price | money_without_trailing_zeros }}</div>
                  </div>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
        <div class="col col-total">
          <div class="message-bar klarna d-none d-lg-block">
            <strong>Afterpay</strong> or <strong>Klarna</strong> Available During Checkout
          </div>

          <div class="total-div first">
            <span class="label">Discount Code</span>
            <span class="calculated float-right">Applied at Checkout</span>
          </div>
          <div class="total-div">
            <span class="label">Shipping</span>
            <span id="shipping-calc" class="calculated float-right">Calculated at Checkout</span>
          </div>
          <div class="total-div">
            <span class="label">Subtotal</span>
            {{ cart.total_price | money_without_trailing_zeros }}
          </div>
          <input type="submit" class="checkout-btn" name="checkout" value="{{ 'cart.general.checkout' | t | escape }}">

          {% comment %}{% include 'gift-option-cart-attributes' %} {% endcomment %}

          <div class="d-none d-lg-block"></div>

          {% comment %}<div class="cart-footer mobile d-block d-lg-none">
            <h3 class="title">Need help?</h3>
            <img id="show-links" alt="Down Arrow" class="arrow" src="{{ 'cart-arrow.svg' | asset_url }}">

            <div id="mobile-links" class="links">
              <div class="wrapper">
                <div class="col">
                  <a href="/pages/returns">Returns</a>
                </div>
                <div class="col middle">
                  <a href="/pages/shipping">Shipping</a>
                </div>
                <div class="col last">
                  <a href="/pages/contact">Contact Us</a>
                </div>
              </div>
            </div>

            <script>
              $('#show-links').click(function() {
                $(this).toggleClass('opened');
                $('#mobile-links').slideToggle();
              })
            </script>
          </div>{% endcomment %}
        </div>
      </div>

      {% comment %}
        <div class="update-continue">
          <input class="update textbutton" type="submit" name="update" value="{{ 'cart.general.update' | t | escape }}" />
          <span>|</span>
          <a data-cc-animate-click class="continue" href="{{ collection_url }}">{{ 'cart.general.continue' | t }}</a>
        </div>
      {% endcomment %}

      <div class="under-cart">
        {% comment %}
          <div class="subtotal-row">
            {%- if cart.cart_level_discount_applications != blank -%}
              <ul class="cart-discount-list align-right">
                {%- for discount_application in cart.cart_level_discount_applications -%}
                  <li class="cart-discount cart-discount--inline">
                    <span class="cart-discount__label">{{ discount_application.title }}</span>
                    <span class="cart-discount__amount">-<span class="theme-money">{{ discount_application.total_allocated_amount | money }}</span></span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="subtotal">
              <span class="label">{{ 'cart.general.subtotal' | t }}</span>
              <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_total" style="display:none !important;"></span>
              <span class="amount theme-money">{{ cart.total_price | money_without_trailing_zeros }}</span>
            </div>
          </div>
        {% endcomment %}

        {% if section.settings.cart_note_show %}
          <p class="note-area">
            <label for="note">{{ 'cart.label.note' | t }}</label>
            <textarea id="note" name="note">{{ cart.note }}</textarea>
          </p>
        {% endif %}

        {% if section.settings.cart_terms_show %}
          <p class="terms rte">
            <input type="checkbox" id="terms">
            {% assign terms_url = pages[section.settings.cart_terms_page].url %}
            {% capture terms_label_html %}<label for="terms">{{ 'cart.terms.agreement_html' | t: terms_url: terms_url }}</label>{% endcapture %}
            {% if section.settings.cart_terms_page == blank %}
              {{ terms_label_html | replace: '<a ', '<span ' | replace: '</a>', '</span>' }}
            {% else %}
              {{ terms_label_html }}
            {% endif %}
          </p>
        {% endif %}

        {% if section.settings.show_tax_and_shipping %}
          {%- capture taxes_shipping_checkout -%}
          {%- if shop.taxes_included and shop.shipping_policy.body != blank -%}
            {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- elsif shop.taxes_included -%}
            {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- else -%}
            {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
          {%- endif -%}
        {%- endcapture -%}

          <div class="cart-policies rte">{{ taxes_shipping_checkout }}</div>
        {% endif %}

        {% comment %} <input type="submit" class="checkout-btn" name="checkout" value="{{ 'cart.general.checkout' | t | escape }}" /> {% endcomment %}

        {% comment %}Paypal and Google checkout buttons{% endcomment %}
        {% if section.settings.show_additional_checkout_buttons
          and additional_checkout_buttons
          and section.settings.cart_terms_show == false
        %}
          <div class="additional-checkout-buttons">
            {{ content_for_additional_checkout_buttons }}
          </div>
        {% endif %}
      </div>
    </form>

    <div class="you-might-like-container">
      <h2 class="title">{{ collections['you-might-like'].title }}</h2>
      <div
        class="carousel"
        data-flickity='{ "cellAlign": "left", "contain": true, "pageDots": false, "imagesLoaded": true, "wrapAround": true }'
      >
        {% for product in collections['you-might-like'].products %}
          <div class="carousel-cell">
            {% render 'product-block',
              product: product,
              product_class: '',
              i: forloop.index,
              show_vendor: false,
              no_quick: false,
              quick_add: true,
              no_swatch: true,
              cart_quick: true
            %}
            {% comment %}
              <form action="/cart/add" method="POST">
                <input type="hidden" name="form_type" value="product">
                <input type="hidden" name="id" value="{{ product.variants[0].id }}">
                <input type="hidden" name="quantity" value="1">
                <button class="cta" type="submit">ADD TO BAG</button>
              </form>
            {% endcomment %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="cart-footer d-none d-lg-block">
      <h3 class="title">Need help?</h3>
      <div class="links">
        <a href="/pages/returns">Returns</a>
        <a href="/pages/shipping">Shipping</a>
        <a href="/pages/contact">Contact Us</a>
      </div>
    </div>

  {% else %}
    <div>
      <div class="rte" data-cc-animate data-cc-animate-delay="0.4s">
        <p data-cc-animate data-cc-animate-delay="0.2s" class="align-center empty">
          {{ 'cart.general.empty' | t }}
        </p>
        <p class="align-center">
          <a data-cc-animate-click href="/collections/shop-all" class="continue button cta">
            {{- 'cart.general.continue_browsing' | t -}}
          </a>
        </p>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "checkbox",
      "id": "cart_terms_show",
      "label": "Show Terms and Conditions checkbox",
      "info": "Additional checkout buttons will be hidden",
      "default": false
    },
    {
      "type": "page",
      "id": "cart_terms_page",
      "label": "Page for Terms and Conditions link"
    },
    {
      "type": "checkbox",
      "id": "cart_note_show",
      "label": "Enable order notes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_and_shipping",
      "label": "Show tax and shipping information",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_additional_checkout_buttons",
      "label": "Show additional checkout options",
      "default": true,
      "info": "Display other gateways and quick checkout buttons. [Read more](https://help.shopify.com/en/manual/payments/accelerated-checkouts)"
    },
    {
      "type": "checkbox",
      "id": "show_backorder_text",
      "label": "Show backorder text",
      "default": true,
      "info": "Only shows for products which use Shopify inventory tracking and are available to purchase when out of stock."
    }
  ]
}
{% endschema %}
