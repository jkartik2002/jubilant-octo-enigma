        <script>
          var options = {
                cellAlign: 'left',
                contain: true,
                pageDots: false,
                imagesLoaded: true,
                resize: true,
                adaptiveHeight: true
              };

          var productCarousel{{ passportCollection.handle | remove: '-' }} = $('.carousel.{{ passportCollection.handle }}').flickity(options);
          var productCarousel{{ passportCollection.handle | remove: '-' }}XS = $('.carousel.{{ passportCollection.handle }}-xs').flickity(options);

          $(document).ready(() => {
            $('#region').on('change',function() {
              var value = $(this).val(),
                  title = $(this).find(':selected').data('title'),
                  handle = $(this).find(':selected').data('handle'),
                  url = $(this).find(':selected').data('url'),
                  image = $(this).find(':selected').data('image'),
                  image2 = $(this).find(':selected').data('image-2'),
                  image2xs = $(this).find(':selected').data('image-2-xs');

              $('#passport-title').text(title);
              $('#passport-url').attr('href', url);
              $('#carousel-wrapper').css('background',`url(${image})`);
              if($(window).width() > 1099) {
                $('.carousel-inner-wrapper').css('background',`url(${image2})`);
              } else {
                $('.carousel-inner-wrapper').css('background',`url(${image2xs})`);
              }
              $('div.carousel-region').hide();

              let index = 0;

              if($(window).width() < 1100) {
                $(`#carousel-${handle}-xs`).show();
                productCarousel{{ passportCollection.handle | remove: '-' }}XS.flickity('resize');
                index = $(`#carousel-${handle}-xs div.carousel-cell.is-selected`).index() + 1;

                var total = $(`#carousel-${handle}-xs div.carousel-cell`).length;
                var percent = (index / total) * 100;
                $('div.progress-bar').css('width',`${percent}%`);
              } else {
                $(`#carousel-${handle}`).show();
                productCarousel{{ passportCollection.handle | remove: '-' }}.flickity('resize');
                index = $(`#carousel-${handle} div.carousel-cell.is-selected`).index() + 1;

                var carouselSize = $(`div.carousel-region.${handle} div.carousel-cell`).length;
                $('#total-pages').text(carouselSize);
              }

              $('#passport-current-page').text(index);
            })

            productCarousel{{ passportCollection.handle | remove: '-' }}.on('change.flickity', function(event, index) {
              $('#passport-current-page').text(index + 1);
            });

            productCarousel{{ passportCollection.handle | remove: '-' }}XS.on('change.flickity', function(event, index) {
              $('#passport-current-page').text(index + 1);
            });

            var progressBar = document.querySelector('.progress-bar')

            productCarousel{{ passportCollection.handle | remove: '-' }}XS.on('change.flickity', function() {
              var index = $(`#carousel-{{ passportCollection.handle }}-xs div.carousel-cell.is-selected`).index() + 1,
                  total = $(`#carousel-{{ passportCollection.handle }}-xs div.carousel-cell`).length,
                  progress = index / total;
              progressBar.style.width = progress * 100 + '%';
            });
          })
        </script>
      {% endfor %}
    </div>

    <div class="progress-wrapper d-block d-lg-none">
      <div class="progress-bar"></div>
    </div>

    <div class="carousel-pagination d-none d-lg-block">
      <span id="passport-current-page" class="num current-page">1</span>
      <span class="num divider">/</span>
      <span id="total-pages" class="num total-pages d-none d-lg-inline-block">0</span>
    </div>
    <script>
      $(document).ready(() => {
        var size = $('div.carousel-1 div.carousel-cell').length,
            indexXS = $('div.carousel-1-xs div.carousel-cell.is-selected').index() + 1,
            totalXS = $('div.carousel-1-xs div.carousel-cell').length,
            percent = (indexXS / totalXS) * 100;

        $('#total-pages').text(size);
        $('div.progress-bar').css('width',`${percent}%`);

        if($(window).width() < 1100) {
          var firstHeight = $('div.carousel-inner-wrapper').height(),
            boxHeight = firstHeight - 24;

          $('div.bg-box').css('height',`${boxHeight}px`);
        }
      })
    </script>
    <style>
      @media (max-width: 1099px) {
        .carousel-inner-wrapper {
          background: url("{{ section.blocks[0].settings.bg-image-2-xs | img_url: '1000x' }}") !important;
        }
      }
    </style>
