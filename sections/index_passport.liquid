{% schema %}
  {
    "name": "Passport",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "FILL YOUR PASSPORT"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Collect the pieces from your favorite destinations around the globe"
      }
    ],
    "blocks": [
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "image_picker",
            "id": "bg-image",
            "label": "Main Background Image"
          },
          {
            "type": "image_picker",
            "id": "bg-image-2",
            "label": "Passport Booklet Background Image - Desktop",
            "info": "Recommended 1000px x 690px"
          },
