<section class="passport">
  <h3 class="title">{{ section.settings.title }}</h3>
  <h2 class="title">{{ section.settings.subtitle }}</h3>

  <div id="carousel-wrapper" class="carousel-wrapper" style="background: url({{ section.blocks[0].settings.bg-image | img_url: '1700x' }});">
    <select id="region" class="area-picker noreplace">
      {% for block in section.blocks %}
        {% assign passportCollection = collections[block.settings.collection] %}
        <option value="{{ passportCollection.handle }}" data-handle="{{ passportCollection.handle }}" data-title="{{ passportCollection.title }}" data-url="{{ passportCollection.url }}" data-image="{{ block.settings.bg-image | img_url: '1700x' }}" data-image-2="{{ block.settings.bg-image-2 | img_url: '1000x' }}" data-image-2-xs="{{ block.settings.bg-image-xs | img_url: '1000x' }}">{{ passportCollection.title }}</option>
      {% endfor %}
    </select>

    <div class="bg-box"></div>
    <div class="carousel-inner-wrapper" style="background: url({{ section.blocks[0].settings.bg-image-2 | img_url: '1000x' }});">
      <div class="carousel-header">
        <div id="passport-title" class="title">{{ collections[section.blocks[0].settings.collection].title }}</div>
        <a id="passport-url" href="{{ collections[section.blocks[0].settings.collection].url }}" class="shop-all">
          SHOP ALL
          <img alt="Right Arrow" class="arrow" src="{{ 'arrow-right.svg' | asset_url }}">
        </a>
      </div>
      {% for block in section.blocks %}
        {% assign passportCollection = collections[block.settings.collection] %}
