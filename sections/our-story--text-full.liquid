<section class="text-full index {% if section.settings.extra_padding %}extra-padding{% endif %} our-story">
  <div class="text-wrapper" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
    {% if section.settings.title != blank %}
      <h3 class="title">{{ section.settings.title }}</h3>
    {% endif %}
    <div class="desc {% if section.settings.extra_padding %}d-none d-lg-block{% endif %}">{{ section.settings.desc }}</div>
    <a class="cta" href="{{ section.settings.button-url }}">{{ section.settings.button-text }}</a>
  </div>

  {% if section.settings.image-1 %}
    <img class="floating-image image-1 lazyload"
         data-src="{{ section.settings.image-1 | img_url: '600x' }}"
         src="{{ section.settings.image-1 | img_url: '20x' }}"
         data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
  {% endif %}
  {% if section.settings.image-2 %}
    <img class="floating-image image-2 d-none d-lg-block lazyload"
         data-src="{{ section.settings.image-2 | img_url: '600x' }}"
         src="{{ section.settings.image-2 | img_url: '20x' }}"
         data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
    <img class="floating-image image-2 d-block d-lg-none lazyload"
         data-src="{{ section.settings.image-2-xs | img_url: '600x' }}"
         src="{{ section.settings.image-2-xs | img_url: '20x' }}"
         data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
  {% endif %}
  {% if section.settings.image-3 %}
    <img class="floating-image image-3 d-none d-lg-block lazyload"
         data-src="{{ section.settings.image-3 | img_url: '600x' }}"
         src="{{ section.settings.image-3 | img_url: '20x' }}"
         data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
    <img class="floating-image image-3 d-block d-lg-none lazyload"
         data-src="{{ section.settings.image-3-xs | img_url: '600x' }}"
         src="{{ section.settings.image-3-xs | img_url: '20x' }}"
         data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
  {% endif %}
  {% if section.settings.image-4 %}
    <img class="floating-image image-4 lazyload"
         data-src="{{ section.settings.image-4 | img_url: '600x' }}"
         src="{{ section.settings.image-4 | img_url: '20x' }}"
         data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
  {% endif %}
</section>

{% schema %}
  {
    "name": "Text Feature",
    "settings": [
      {
        "type": "checkbox",
        "id": "extra_padding",
        "label": "Extra Vertical Padding?"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "YOUR WEARABLE TRAVEL DIARY"
      },
      {
        "type": "richtext",
        "id": "desc",
        "label": "Body Text",
        "default": "<p>Mix and match your charms on chains and bracelets and tell your own unique story. Whether you’re an avid traveler or simply have hometown pride...the possibilities are endless and so is the fun.</p>"
      },
      {
        "type": "text",
        "id": "button-text",
        "label": "Button Text",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "button-url",
        "label": "Button URL"
      },
      {
        "type": "image_picker",
        "id": "image-1",
        "label": "Floating Image 1 - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-2",
        "label": "Floating Image 2 - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-2-xs",
        "label": "Floating Image 2 - Mobile"
      },
      {
        "type": "image_picker",
        "id": "image-3",
        "label": "Floating Image 3 - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-3-xs",
        "label": "Floating Image 3 - Mobile"
      },
      {
        "type": "image_picker",
        "id": "image-4",
        "label": "Floating Image 4 - Desktop"
      }
    ],
    "presets": [
	    {
        "name": "Text Feature",
        "category": "Custom",
        "settings": {}
      }
    ]
  }
{% endschema %}
