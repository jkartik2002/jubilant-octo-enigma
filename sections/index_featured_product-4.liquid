<section class="product-feature feature-2 feature-4">
  <div class="wrapper">
    {% if section.settings.product != blank %}
      {% assign url = all_products[section.settings.product].url %}
    {% elsif section.settings.collection != blank %}
      {% assign url = collections[section.settings.collection].url %}
    {% endif %}
    <div class="column left" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s">
      {% assign product1 = all_products[section.settings.product] %}
      <h2 class="title">{{ section.settings.title }}</h2>
      <div class="desc">{{ section.settings.desc }}</div>
      <a class="cta" href="{{ url }}">{{ section.settings.button-text }}</a>

      {% if section.settings.product != blank %}
        <div class="d-none d-lg-block">
          {% render 'product-block', product: product1, product_class: '', i: 0, show_vendor: false, category: 'Homepage Featured Product' %}
        </div>
      {% endif %}
    </div>
    <div class="column right" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
      <div class="position-relative">
        <div class="img-bg" style="background: {{ section.settings.color }};"></div>
        <a href="{{ url }}">
          {% assign img_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
          <img 
            class="left-image lazyload"
            alt="{{ section.settings.title | strip_html }}"
            data-src="{{ img_url }}"
            data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
            data-aspectratio="{{ section.settings.image.aspect_ratio }}"
            data-sizes="auto"
            width="727"
            height="727"
            data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
          />
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Product Feature 4",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "color",
        "id": "color",
        "label": "Background Color",
        "default": "#D2FDED"
      },
      {
        "type": "richtext",
        "id": "title",
        "label": "Title",
        "default": "<p>Bring Home <i>the</i> Big Apple</p>"
      },
      {
        "type": "textarea",
        "id": "desc",
        "label": "Description",
        "default": "Fridge magnets are fun, but it's time to get something as unforgettable as the city that never sleeps. Find the perfect souvenir to carry the concrete jungle with you every day–those amazing memories never need to fade."
      },
      {
        "type": "text",
        "id": "button-text",
        "label": "Button Text",
        "default": "SHOP NEW YORK"
      },
      {
        "type": "product",
        "id": "product",
        "label": "Product",
        "info": "Only fill out either Product or Collection"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }
    ],
    "presets": [
	    {
        "name": "Product Feature 4",
        "category": "Custom",
        "settings": {}
      }
    ]
  }
{% endschema %}
