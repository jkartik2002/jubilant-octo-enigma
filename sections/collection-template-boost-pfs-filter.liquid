<script>
  var flag = false;
  var imageFlagForMobile = false;
  var imageFlagForDesktop = false;
  document.addEventListener("DOMContentLoaded", () => {
    if(document.querySelector(".custom-banner .banner-full-desc")){
      document.querySelector(".custom-banner .banner-full-desc").style.display = "none";
    }
    if(document.querySelector(".promotion-message-view .banner-full-desc")){
      document.querySelector(".promotion-message-view .banner-full-desc").style.display = "none";
    }

    var truncateLength = 100;
    if(window.matchMedia("(max-width: 767px)").matches){
      var truncateLength = 70;
    }

    const bannerDescs = document.querySelectorAll('.banner-short-desc');
    bannerDescs.forEach((bannerDesc) => {
      const fullText = bannerDesc.innerText.trim();

        if(bannerDesc.parentElement.parentElement.classList.contains("promotion-message-view")){
          if(window.matchMedia("(max-width: 767px)").matches){
            var truncateLength = 20;
          }else{
            var truncateLength = 20;
          }
        }else{
          if(window.matchMedia("(max-width: 767px)").matches){
            var truncateLength = 70;
          }else{
            var truncateLength = 100;
          }
        }

        if (fullText.length > truncateLength) {
          var visibleText = "";
          var remainingText = "";
          const truncatePoint = fullText.lastIndexOf(' ', truncateLength);
          if(bannerDesc.parentElement.parentElement.classList.contains("promotion-message-view")){
            var testing = "";
            if(truncatePoint > 0){
              testing = fullText.slice(0, truncatePoint);
            }else{
              testing = fullText.slice(0, truncateLength);
            }
            var p = `{{ collection.metafields.custom.promotion_short_description | metafield_tag }}`;
            if(p != ""){
              var onlyHTML = p.replace(/<div class="metafield-rich_text_field"><p>|<\/p><\/div>/g, '');
              visibleText = onlyHTML;
              var remainingText = testing+' '+fullText.slice(visibleText.length);
            }else{
              var visibleText = truncatePoint > 0 ? fullText.slice(0, truncatePoint) : fullText.slice(0, truncateLength);
              var remainingText = fullText.slice(visibleText.length);
            }
          }else{
            var visibleText = truncatePoint > 0 ? fullText.slice(0, truncatePoint) : fullText.slice(0, truncateLength);
            var remainingText = fullText.slice(visibleText.length);
          }
          if (!bannerDesc.querySelector('.remaining-text')) {
            bannerDesc.innerHTML = `
                ${visibleText}<span class="remaining-text" style="visibility: hidden;">${remainingText}</span>
                <a href="javascript:void(0)" onclick="readMore(this);">Read More</a>
            `;
          }
        }
    });
  });
  if(window.matchMedia("(max-width: 767px)").matches){
    {% for colmeta in collection.metafields.custom.shop_all.value %}
      {% if forloop.index > 2 %}
          var flag = true;
      {% endif %}
      {% if colmeta.image_for_mobile != blank %}
        var imageFlagForMobile = true;
      {% endif %}
    {% endfor %}
    if(flag){
      var options = {};
      setTimeout(() => {
        if(imageFlagForMobile){
          var options = {
            imagesLoaded: true,
            pageDots: false,
            cellAlign: 'left',
            contain: true
          };
        }else{
          var options = {
            pageDots: false,
            cellAlign: 'left',
            contain: true
          };
        }
        var flkty = new Flickity( '.banner-content', options);
      },1000);
      setTimeout(() => {
        var flkty = new Flickity( '.banner-content', options);
        flkty.reloadCells();
      },2500)
    }
  }else{
    {% for colmeta in collection.metafields.custom.shop_all.value %}
      {% if forloop.index > 7 %}
          var flag = true;
      {% endif %}
      {% if colmeta.image != blank %}
        var imageFlagForDesktop = true;
      {% endif %}
    {% endfor %}
    if(flag){
      var options = {};
      setTimeout(() => {
        if(imageFlagForDesktop){
          var options = {
            imagesLoaded: true,
            pageDots: false,
            cellAlign: 'left',
            contain: true
          };
        }else{
          var options = {
            groupCells: 7,
            pageDots: false,
            cellAlign: 'left',
            contain: true
          };
        }
        var flkty = new Flickity( '.banner-content', options);
      },1500);
      setTimeout(() => {
        var flkty = new Flickity( '.banner-content', options);
        flkty.reloadCells();
      },2500)
    }
  }
  function readMore(el){
    const bannerDesc = el.closest('.banner-short-desc');
    const remainingText = bannerDesc.querySelector('.remaining-text');
    if (remainingText){
      if (remainingText.style.visibility === 'hidden'){
        remainingText.style.visibility = 'visible';
        el.textContent = 'Read Less';
      } else {
        remainingText.style.visibility = 'hidden';
        el.textContent = 'Read More';
      }
    }
  }
  function readLess(event){
    event.parentElement.parentElement.querySelector(".banner-full-desc").style.display = "none";
    if(event.parentElement.parentElement.querySelector(".banner-short-desc").style.display == "none"){
      event.parentElement.parentElement.querySelector(".banner-short-desc").style.display = "block";
    }
  }
</script>

