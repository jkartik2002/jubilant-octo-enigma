      </div>

      <div class="progress-wrapper d-block d-lg-none">
        <div class="progress-bar"></div>
      </div>
      <script>
        var options = {
          cellAlign: 'left',
          contain: true,
          pageDots: false,
          imagesLoaded: true,
          wrapAround: true
        };

        var $inspirationCarousel = $('.carousel-insp').flickity(options);

        $(document).ready(() => {
          var size = $('div.carousel-insp div.carousel-cell').length,
              indexXS = $('div.carousel-insp div.carousel-cell.is-selected').index() + 1,
              totalXS = $('div.carousel-insp div.carousel-cell').length,
              percent = (indexXS / totalXS) * 100;

          $('#total-pages-insp').text(size);
          $('div.progress-bar').css('width',`${percent}%`);

          $inspirationCarousel.on('change.flickity', function(event, index) {
            var indexXS = $('div.carousel-insp div.carousel-cell.is-selected').index() + 1,
                totalXS = $('div.carousel-insp div.carousel-cell').length,
                percent = (indexXS / totalXS) * 100;

            $('#current-page-insp').text(index + 1);
            $('div.progress-bar').css('width',`${percent}%`);
          });
        })
      </script>
