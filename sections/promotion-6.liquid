{% for block in section.blocks %}
  {% if block.type == 'media-and-text' %}
    <section class="product-image-text video">
      <div class="wrapper">
        {% unless block.settings.video-right %}
          <div class="col left">
            <div class="image-wrapper">
              <div class="bg-image"></div>
              {% if block.settings.video-link != blank %}
                <video class="video" playsinline="" autoplay="" muted="" loop="">
                  <source src="{{ block.settings.video-link }}">
                </video>
              {% elsif block.settings.gif-link != blank %}
                <img alt="{{ block.settings.title | escape | strip }}" src="{{ block.settings.gif-link }}">
              {% elsif block.settings.image-link != blank %}
                {% assign img_url = block.settings.image-link | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
                <img 
                  class="lazyload"
                  {% if forloop == 1 %}
                  src="{{ block.settings.image-link | img_url: '360x' }}"
                  {% endif %}
                  alt="{{ block.settings.title | escape | strip }}"
                  data-src="{{ img_url }}"
                  data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
                  data-aspectratio="{{ block.settings.image-link.aspect_ratio }}"
                  data-sizes="auto"
                  style="display: block; width: 100%; height: auto;"
                  width="{{ block.settings.image-link.width }}"
                  height="{{ block.settings.image-link.height }}"
                  data-cc-animate="cc-fade-in-up"
                />
              {% endif %}
            </div>
          </div>
        {% endunless %}
        <div class="col right">
          <h2 class="title">{{ block.settings.title }}</h2>
          <div class="desc">{{ block.settings.text }}</div>
        </div>
        {% if block.settings.video-right %}
          <div class="col right">
            <div class="image-wrapper">
              <div class="bg-image"></div>
