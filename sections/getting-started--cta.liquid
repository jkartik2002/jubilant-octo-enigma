<section class="bracelet-guide bracelet-guide--cta getting-started">
  <h2 class="title">{{ section.settings.title }}</h2>
  <div class="desc">{{ section.settings.text }}</div>
  <a class="cta" href="{{ section.settings.button-url }}">{{ section.settings.button-text }}</a>
</section>

{% schema %}
  {
    "name": "CTA",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Got More Questions?"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "Schedule your virtual shopping experience with a JSC stylist."
      },
      {
        "type": "text",
        "id": "button-text",
        "label": "Button Text",
        "default": "BOOK NOW"
      },
      {
        "type": "url",
        "id": "button-url",
        "label": "Button URL"
      }
    ]
  }
{% endschema %}
