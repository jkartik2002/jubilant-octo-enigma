{% if section.settings.show-section %}
  <section class="bracelet-guide bracelet-guide--size-chart">
    <div class="guide-wrapper">
      <h2 class="title d-none d-lg-block">{{ section.settings.title }}</h2>
      <h2 class="title d-block d-lg-none">{{ section.settings.title-xs }}</h2>
      {% if section.settings.chart-1-title !=blank %}
      <h3 class="subtitle">
        {{ section.settings.chart-1-title }}
        <img alt="{{ section.settings.chart-1-title }}" class="lazyload" data-src="{{ section.settings.image-1 | img_url: '200x' }}">
      </h3>
{% endif %}
      <table>
        <thead>
          <tr>
            <td class="first">Size</td>
            <td class="rxs">Silver</td>
            <td class="rxs">Gold</td>
            <td class="rxs">Solid Gold</td>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="first">{{ section.settings.chart-1-row-1-col-1 }}</td>
            <td class="rxs">{{ section.settings.chart-1-row-1-col-2 }}</td>
            <td class="rxs">{{ section.settings.chart-1-row-1-col-3 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-1-col-4 }}</td>
          </tr>
          <tr>
            <td class="first">{{ section.settings.chart-1-row-2-col-1 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-2-col-2 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-2-col-3 }}</td>
            <td class="rxs">{{ section.settings.chart-1-row-2-col-4 }}</td>
          </tr>
          <tr>
            <td class="first">{{ section.settings.chart-1-row-3-col-1 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-3-col-2 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-3-col-3 }}</td>
            <td class="rxs">{{ section.settings.chart-1-row-3-col-4 }}</td>
          </tr>
          <tr>
            <td class="first">{{ section.settings.chart-1-row-4-col-1 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-4-col-2 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-4-col-3 }}</td>
            <td class="rxs">{{ section.settings.chart-1-row-4-col-4 }}</td>
          </tr>
          <tr class="bottom">
            <td class="first">{{ section.settings.chart-1-row-5-col-1 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-5-col-2 }}</td>
            <td class="price rxs">{{ section.settings.chart-1-row-5-col-3 }}</td>
            <td class="rxs">{{ section.settings.chart-1-row-5-col-4 }}</td>
          </tr>
          <tr class="bottom">
            <td class="first">{{ section.settings.chart-1-row-6-col-1 }}</td>
            <td class="price cxs">
              <img alt="Silver Link" class="link d-none d-lg-inline-block lazyload" data-src="{{ 'link-silver.png' | asset_img_url: '200x' }}">
              {{ section.settings.chart-1-row-6-col-2 }}
            </td>
            <td class="price cxs">
              <img alt="Gold Link" class="link d-none d-lg-inline-block lazyload" data-src="{{ 'link-gold.png' | asset_img_url: '200x' }}">
              {{ section.settings.chart-1-row-6-col-3 }}
            </td>
            <td class="rxs">
              <img alt="Solid Gold Link" class="link d-none d-lg-inline-block lazyload" data-src="{{ 'link-gold.png' | asset_img_url: '200x' }}">
              {{ section.settings.chart-1-row-6-col-4 }}
            </td>
          </tr>
        </tbody>
      </table>
{% if section.settings.chart-2-title !=blank %}
      <h3 class="subtitle">
        {{ section.settings.chart-2-title }}
        <img alt="{{ section.settings.chart-2-title }}" class="lazyload" data-src="{{ section.settings.image-2 | img_url: '200x' }}">
      </h3>
{% endif %}
      <table>
        <thead>
          <tr>
            <td class="first">Size</td>
            <td class="rxs">Silver</td>
            <td class="rxs">Gold</td>
            <td class="rxs">Solid Gold</td>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="first">{{ section.settings.chart-2-row-1-col-1 }}</td>
            <td class="rxs">{{ section.settings.chart-2-row-1-col-2 }}</td>
            <td class="rxs">{{ section.settings.chart-2-row-1-col-3 }}</td>
            <td class="price rxs">{{ section.settings.chart-2-row-1-col-4 }}</td>
          </tr>
        </tbody>
      </table>

    {% if section.settings.chart-3-title !=blank %}
      <h3 class="subtitle">
        {{ section.settings.chart-3-title }}
        <img alt="{{ section.settings.chart-3-title }}" class="lazyload" data-src="{{ section.settings.image-3 | img_url: '200x' }}">
      </h3>
{% endif %}
      <table>
        <thead>
          <tr>
            <td class="first">Size</td>
            <td class="rxs">Silver</td>
            <td class="rxs">Gold</td>
            <td class="rxs">Solid Gold</td>
          </tr>
        </thead>
        <tbody>
          <tr>
            {% if section.settings.chart-3-row-1-col-1 !=blank  %}
              <td class="first">{{ section.settings.chart-3-row-1-col-1 }}</td>
            {% endif %}
            {% if section.settings.chart-3-row-1-col-2 !=blank  %}
             <td class="rxs">{{ section.settings.chart-3-row-1-col-2 }}</td>
            {% endif %}
            {% if section.settings.chart-3-row-1-col-3  !=blank  %}
             <td class="rxs">{{ section.settings.chart-3-row-1-col-3 }}</td>
            {% endif %}
            {% if section.settings.chart-3-row-1-col-4 !=blank  %}
             <td class="price rxs">{{ section.settings.chart-3-row-1-col-4 }}</td>
            {% endif %}
          </tr>
          <tr>
            {% if section.settings.chart-3-row-2-col-1 !=blank  %}
              <td class="first">{{ section.settings.chart-3-row-2-col-1 }}</td>
            {% endif %}
            {% if section.settings.chart-3-row-2-col-2 !=blank  %}
             <td class="rxs">{{ section.settings.chart-3-row-2-col-2 }}</td>
            {% endif %}
            {% if section.settings.chart-3-row-2-col-3  !=blank  %}
             <td class="rxs">{{ section.settings.chart-3-row-2-col-3 }}</td>
            {% endif %}
            {% if section.settings.chart-3-row-2-col-4 !=blank  %}
             <td class="price rxs">{{ section.settings.chart-3-row-2-col-4 }}</td>
            {% endif %}
          </tr>
        </tbody>
      </table>

      {% comment %} <h3 class="subtitle">
        Paperclip
        {% if section.settings.image-3 != blank %}
          <img alt="Paperclip Bracelet" src="{{ section.settings.image-3 | img_url: '200x' }}">
        {% endif %}
      </h3>

      <table>
        <thead>
          <tr>
            <td class="first">Size</td>
            <td class="rxs">Silver</td>
            <td class="rxs">Gold</td>
            <td class="rxs">Solid Gold</td>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="first">7”</td>
            <td class="rxs">$50</td>
            <td class="rxs">$70</td>
            <td class="price rxs">-</td>
          </tr>
          <tr>
            <td class="first">8”</td>
            <td class="rxs">$50</td>
            <td class="rxs">$70</td>
            <td class="price rxs">-</td>
          </tr>
        </tbody>
      </table> {% endcomment %}
    </div>
  </section>
{% endif %}

