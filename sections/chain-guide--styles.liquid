{% if section.settings.show-section %}
  <section class="bracelet-guide bracelet-guide--styles chain-guide--styles">
    <div class="inner-wrapper">
      <h2 class="title">{{ section.settings.title }}</h2>
      {% if section.settings.desc != blank %}
        <div class="desc top">{{ section.settings.desc }}</div>
      {% endif %}

      <div class="wrapper">
        <div class="col">
          {% assign collection1 = collections[section.settings.collection-1] %}
          <a href="{{ collection1.url }}">
            <img alt="" class="hover-bg lazyload" data-src="{{ 'hover-effect.png' | asset_img_url: '500x' }}">
            {% assign img_url = section.settings.image-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
            <img 
              class="d-none d-lg-block lazyload"
              alt="{{ section.settings.title | escape | strip }}"
              data-src="{{ img_url }}"
              data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
              data-aspectratio="{{ section.settings.image-1.aspect_ratio }}"
              data-sizes="auto"
              style="display: block; width: 100%; height: auto;"
              width="{{ section.settings.image-1.width }}"
              height="{{ section.settings.image-1.height }}"
              data-cc-animate="cc-fade-in-up"
              data-cc-animate-delay="0.1s"
            />
            <div class="title">{{ section.settings.title-1 }}</div>
          </a>
        </div>
