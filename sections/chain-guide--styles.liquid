      {
        "type": "richtext",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "desc",
        "label": "Desc",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing."
      },
      {
        "type": "image_picker",
        "id": "image-1",
        "label": "Image 1"
      },
      {
        "type": "collection",
        "id": "collection-1",
        "label": "Collection Link 1"
