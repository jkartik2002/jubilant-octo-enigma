{% if section.settings.show-section %}
  <section class="bracelet-guide bracelet-guide--hero chain-guide--hero">
    <h1 class="title">{{ section.settings.title }}</h1>
    {% assign img_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="floating floating-2 d-none d-lg-block lazyload"
      alt="{{ section.settings.title | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image.aspect_ratio }}"
      data-sizes="auto"
      style="display: block; width: 100%; height: auto;"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      data-cc-animate="cc-fade-down-up"
    />
    {% assign img_url = section.settings.image-xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="floating floating-2 d-block d-lg-none lazyload"
      alt="{{ section.settings.title | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-xs.aspect_ratio }}"
      data-sizes="auto"
      style="display: block; width: 100%; height: auto;"
      width="{{ section.settings.image-xs.width }}"
      height="{{ section.settings.image-xs.height }}"
      data-cc-animate="cc-fade-down-up"
    />
  </section>
{% endif %}

{% schema %}
  {
    "name": "Hero",
    "settings": [
      {
        "type": "checkbox",
        "id": "show-section",
        "label": "Show Section?",
        "default": true
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Title",
        "default": "Chain Guide"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-xs",
        "label": "Image - Mobile"
      }
    ]
  }
{% endschema %}
