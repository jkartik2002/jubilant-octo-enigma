{% if section.settings.show-section %}
  <section class="bracelet-guide bracelet-guide--hero">
    <h1 class="title">{{ section.settings.title }}</h1>

    {% assign img_url = section.settings.image-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="floating floating-1 lazyload"
      alt="{{ section.settings.title | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-1.aspect_ratio }}"
      data-sizes="auto"
      width="{{ section.settings.image-1.width }}"
      height="{{ section.settings.image-1.height }}"
      data-cc-animate="cc-fade-in-up"
    />

    {% assign img_url = section.settings.image-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="floating floating-2 d-none d-lg-block lazyload"
      alt="{{ section.settings.title | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-2.aspect_ratio }}"
      data-sizes="auto"
      width="{{ section.settings.image-2.width }}"
      height="{{ section.settings.image-2.height }}"
      data-cc-animate="cc-fade-down-up"
    />

    {% assign img_url = section.settings.image-2-xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
    <img 
      class="floating floating-2 d-block d-lg-none lazyload"
      alt="{{ section.settings.title | escape | strip }}"
      data-src="{{ img_url }}"
      data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
      data-aspectratio="{{ section.settings.image-2-xs.aspect_ratio }}"
      data-sizes="auto"
      width="{{ section.settings.image-2-xs.width }}"
      height="{{ section.settings.image-2-xs.height }}"
      data-cc-animate="cc-fade-down-up"
    />
  </section>
{% endif %}

{% schema %}
  {
    "name": "Hero",
    "settings": [
      {
        "type": "checkbox",
        "id": "show-section",
        "label": "Show Section?",
        "default": true
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Title",
        "default": "Infinity Link Bracelet Guide"
      },
      {
        "type": "image_picker",
        "id": "image-1",
        "label": "Image 1"
      },
      {
        "type": "image_picker",
        "id": "image-2",
        "label": "Image 2 - Desktop"
      },
      {
        "type": "image_picker",
        "id": "image-2-xs",
        "label": "Image 2 - Mobile"
      }
    ]
  }
{% endschema %}