<section class="getting-started--hero">
  <h1 class="title">{{ section.settings.title }}</h1>
  <div class="desc">{{ section.settings.desc }}</div>
</section>


<section class="getting-started--collection">
  <hr class="gs-line">
  <h2 class="title">{{ section.settings.title-2 }}</h2>

  <div class="wrapper">
    <div class="column left">
      <a href="{{ section.settings.c-cta-url-1 }}">
        {% assign img_url = section.settings.c-image-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="d-none d-lg-block lazyload"
          src="{{ section.settings.c-image-1 | img_url: '360x' }}"
          alt="{{ section.settings.c-title-1 | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.c-image-1.aspect_ratio }}"
          data-sizes="auto"
          style="display: block; width: 100%; height: auto;"
          width="{{ section.settings.c-image-1.width }}"
          height="{{ section.settings.c-image-1.height }}"
          data-cc-animate="cc-fade-in-up"
        />
        {% assign img_url = section.settings.c-image-1-xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="d-block d-lg-none lazyload"
          {% if forloop == 1 %}
          src="{{ section.settings.c-image-1-xs | img_url: '360x' }}"
          {% endif %}
          alt="{{ section.settings.c-title-1 | escape | strip }}"
          data-src="{{ img_url }}"
          data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
          data-aspectratio="{{ section.settings.c-image-1-xs.aspect_ratio }}"
          data-sizes="auto"
          style="display: block; width: 100%; height: auto;"
          width="{{ section.settings.c-image-1-xs.width }}"
          height="{{ section.settings.c-image-1-xs.height }}"
          data-cc-animate="cc-fade-in-up"
        />
      </a>
      <h2 class="title d-none d-lg-block">{{ section.settings.c-title-1 }}</h2>
      <div class="desc">{{ section.settings.c-desc-1 }}</div>
      <a class="cta" href="{{ section.settings.c-cta-url-1 }}">{{ section.settings.c-cta-button-text-1 }}</a>
    </div>
    <div class="column right">
      <a href="{{ section.settings.c-cta-url-2 }}">
        {% assign img_url = section.settings.c-image-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
