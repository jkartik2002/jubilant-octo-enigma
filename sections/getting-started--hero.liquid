          width="{{ section.settings.c-image-2.width }}"
          height="{{ section.settings.c-image-2.height }}"
          data-cc-animate="cc-fade-in-up"
        />
        {% assign img_url = section.settings.c-image-2-xs | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
        <img 
          class="d-block d-lg-none lazyload"
