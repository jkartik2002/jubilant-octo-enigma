          data-cc-animate="cc-fade-in-up"
        />
      </a>
      <h2 class="title d-none d-lg-block">{{ section.settings.c-title-2 }}</h2>
      <div class="desc">{{ section.settings.c-desc-2 }}</div>
      <a class="cta" href="{{ section.settings.c-cta-url-2 }}">{{ section.settings.c-cta-button-text-2 }}</a>
    </div>
  </div>
