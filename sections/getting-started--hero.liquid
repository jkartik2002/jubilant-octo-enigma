  </div>
</section>

{% schema %}
  {
    "name": "Hero",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "desc",
        "label": "Text"
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "text",
        "id": "title-2",
        "label": "Title",
        "default": "Start Your Collection Today!"
      },
      {
        "type": "image_picker",
        "id": "c-image-1",
