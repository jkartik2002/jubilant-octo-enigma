<div class="nosto_element" id="productpage-nosto-4"></div>
<div class="nosto_element" id="productpage-nosto-5"></div>
<section class="index-hero product">
  <div class="wrapper">
    <div class="column">
      {% assign img_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="w-100 lazyload"
        alt="{{ section.settings.title | escape | strip }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image.aspect_ratio }}"
        data-sizes="auto"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      />
    </div>
  </div>
  <div class="text-container flex-container-left-align">
    <div>
      <span class="title">{{ section.settings.title | strip_html }}</span>
      <div class="desc">{{ section.settings.desc }}</div>
    </div>
  </div>

  {% assign img_url = section.settings.charm-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
  <img 
    class="charm charm-1 lazyload"
    alt="{{ section.settings.title | escape | strip }}"
    data-src="{{ img_url }}"
    data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
    data-aspectratio="{{ section.settings.charm-1.aspect_ratio }}"
    data-sizes="auto"
    width="{{ section.settings.charm-1.width }}"
    height="{{ section.settings.charm-1.height }}"
  />
  <img 
    class="charm charm-3 lazyload"
    alt="{{ section.settings.title | escape | strip }}"
    data-src="{{ img_url }}"
    data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
    data-aspectratio="{{ section.settings.charm-1.aspect_ratio }}"
    data-sizes="auto"
    width="{{ section.settings.charm-1.width }}"
    height="{{ section.settings.charm-1.height }}"
  />
  <img 
    class="charm charm-4 lazyload"
    alt="{{ section.settings.title | escape | strip }}"
    data-src="{{ img_url }}"
    data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
    data-aspectratio="{{ section.settings.charm-1.aspect_ratio }}"
    data-sizes="auto"
    width="{{ section.settings.charm-1.width }}"
    height="{{ section.settings.charm-1.height }}"
  />
  <img 
    class="charm charm-6 lazyload"
    alt="{{ section.settings.title | escape | strip }}"
    data-src="{{ img_url }}"
    data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
    data-aspectratio="{{ section.settings.charm-1.aspect_ratio }}"
    data-sizes="auto"
    width="{{ section.settings.charm-1.width }}"
    height="{{ section.settings.charm-1.height }}"
  />


  <div class="floating-text text-1">{{ section.settings.border-text }} {{ section.settings.border-text }}</div>
  <div class="floating-text text-3">{{ section.settings.border-text }} {{ section.settings.border-text }}</div>
  <div class="floating-text text-5">{{ section.settings.border-text }} {{ section.settings.border-text }}</div>
  <div class="floating-text text-6">{{ section.settings.border-text }} {{ section.settings.border-text }}</div>

  {% if section.settings.invert-border-text %}
    <style>
      div.floating-text {
        color: #fff !important;
      }
    </style>
  {% endif %}
</section>

{% schema %}
  {
    "name": "Product Text Lines",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "richtext",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "desc",
        "label": "Text"
      },
      {
        "type": "image_picker",
        "id": "charm-1",
        "label": "Charm Image 1"
      },
      {
        "type": "textarea",
        "id": "border-text",
        "label": "Border Text"
      },
      {
        "type": "checkbox",
        "id": "invert-border-text",
        "label": "Invert Border Text Color"
      }
    ],
    "presets": [
	    {
        "name": "Product Text Lines",
        "category": "Custom",
        "settings": {}
      }
    ]
  }
{% endschema %}
