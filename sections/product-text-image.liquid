{% else %}
  <style>
    section.product-image-text.flipped {
      display: none !important;
    }
  </style>
{% endif %}
<div class="nosto_element" id="productpage-nosto-4"></div>

<div class="nosto_element" id="productpage-nosto-5"></div>
<section class="product-image-text flipped">
  <div class="wrapper">
    {% if product.type contains 'Luggage' %}
      <div class="col left">
        <div class="image-wrapper">
          <div class="bg-image"></div>

          <img alt="{{section.settings.title}}" class="lazyload" data-src="{{ image }}">
        </div>
      </div>
    {% endif %}
    <div class="col {% if product.type contains 'Luggage' %}right{% else %}left{% endif %}">
      {% comment %} <img alt="{{ section.settings.title }}" class="left-img d-none d-lg-inline-block" src="{{ product.images[0].src | img_url: '400x' }}"> {% endcomment %}
      <div class="text-wrapper">
        <h2 class="title">{{ section.settings.title }}</h2>
        <div class="desc">{{ section.settings.text }}</div>
      </div>
    </div>
    {% unless product.type contains 'Luggage' %}
      <div class="col right">
        <div class="image-wrapper">
          <div class="bg-image"></div>

          <img alt="{{ section.settings.title }}" class="lazyload" data-src="{{ image }}">
        </div>
      </div>
    {% endunless %}
  </div>
</section>

{% schema %}
  {
    "name": "Product Size Guide",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Title",
        "default": "Size Comparison"
      },
      {
        "type": "textarea",
        "id": "text",
        "label": "Text"
      }
    ],
    "presets": [
      {
        "name": "Product Text and Image"
      }
    ]
  }
{% endschema %}