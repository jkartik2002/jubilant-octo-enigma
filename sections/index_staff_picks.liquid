<section class="staff-picks">
  <h2 class="title">{{ section.settings.title }}</h2>
    <a class="view-all-link" href="{{ section.settings.button-url }}">
      {{ section.settings.button-text }}
      <img alt="Right Arrow" class="arrow" src="{{ 'arrow-right.svg' | asset_url }}">
    </a>

  <div class="wrapper d-none d-lg-block">
    <div class="column" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s">
      {% assign img_url = section.settings.image-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="lazyload"
        alt="{{ section.settings.image-1 | escape }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image-1.aspect_ratio }}"
        data-sizes="auto"
        style="display: block; width: 100%; height: auto;"
        width="{{ section.settings.image-1.width }}"
        height="{{ section.settings.image-1.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
      />
      <div class="desc">{{ section.settings.text-1 }}</div>
      <div class="name">{{ section.settings.name-1 }}</div>
    </div>
    <div class="column" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s">
      {% assign img_url = section.settings.image-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="rounded lazyload"
        alt="{{ section.settings.image-2 | escape }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image-2.aspect_ratio }}"
        data-sizes="auto"
        style="display: block; width: 100%; height: auto;"
        width="{{ section.settings.image-2.width }}"
        height="{{ section.settings.image-2.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s"
      />
      <div class="desc">{{ section.settings.text-2 }}</div>
      <div class="name">{{ section.settings.name-2 }}</div>
    </div>
    <div class="column" data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".3s">
      {% assign img_url = section.settings.image-3 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="top-rounded lazyload"
        alt="{{ section.settings.image-3 | escape }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image-3.aspect_ratio }}"
        data-sizes="auto"
        style="display: block; width: 100%; height: auto;"
        width="{{ section.settings.image-3.width }}"
        height="{{ section.settings.image-3.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".3s"
      />
      <div class="desc">{{ section.settings.text-3 }}</div>
      <div class="name">{{ section.settings.name-3 }}</div>
    </div>
  </div>

  <div class="carousel carousel-staff-picks d-block d-lg-none" data-flickity='{ "cellAlign": "left", "contain": true, "pageDots": false, "prevNextButtons": false, "imagesLoaded": true }'>
    <div class="carousel-cell">
      {% assign img_url = section.settings.image-1 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="lazyload"
        alt="{{ section.settings.image-1 | escape }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image-1.aspect_ratio }}"
        data-sizes="auto"
        style="display: block; width: 100%; height: auto;"
        width="{{ section.settings.image-1.width }}"
        height="{{ section.settings.image-1.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".1s"
      />
      <div class="desc">{{ section.settings.text-1 }}</div>
      <div class="name">{{ section.settings.name-1 }}</div>
    </div>
    <div class="carousel-cell">
      {% assign img_url = section.settings.image-2 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="lazyload"
        alt="{{ section.settings.image-2 | escape }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image-2.aspect_ratio }}"
        data-sizes="auto"
        style="display: block; width: 100%; height: auto;"
        width="{{ section.settings.image-2.width }}"
        height="{{ section.settings.image-2.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".2s"
      />
      <div class="desc">{{ section.settings.text-2 }}</div>
      <div class="name">{{ section.settings.name-2 }}</div>
    </div>
    <div class="carousel-cell">
      {% assign img_url = section.settings.image-3 | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
      <img 
        class="lazyload"
        alt="{{ section.settings.image-3 | escape }}"
        data-src="{{ img_url }}"
        data-widths="[180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024]"
        data-aspectratio="{{ section.settings.image-3.aspect_ratio }}"
        data-sizes="auto"
        style="display: block; width: 100%; height: auto;"
        width="{{ section.settings.image-3.width }}"
        height="{{ section.settings.image-3.height }}"
        data-cc-animate="cc-fade-in-up" data-cc-animate-delay=".3s"
      />
      <div class="desc">{{ section.settings.text-3 }}</div>
      <div class="name">{{ section.settings.name-3 }}</div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Staff Picks",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Staff Picks"
      },
      {
        "type": "text",
        "id": "button-text",
        "label": "Button Text",
        "default": "SHOP STAFF PICKS"
      },
      {
        "type": "url",
        "id": "button-url",
        "label": "Button URL"
      },
      {
        "type": "image_picker",
        "id": "image-1",
        "label": "Image 1"
      },
      {
        "type": "text",
        "id": "text-1",
        "label": "Text 1",
        "default": "“Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor“"
      },
      {
        "type": "text",
        "id": "name-1",
        "label": "Name 1",
        "default": "Nicole Parker King"
      },
      {
        "type": "image_picker",
        "id": "image-2",
        "label": "Image 2"
      },
      {
        "type": "text",
        "id": "text-2",
        "label": "Text 2",
        "default": "“Exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.”"
      },
      {
        "type": "text",
        "id": "name-2",
        "label": "Name 2",
        "default": "Eva DeLaire"
      },
      {
        "type": "image_picker",
        "id": "image-3",
        "label": "Image 3"
      },
      {
        "type": "text",
        "id": "text-3",
        "label": "Text 3",
        "default": "“Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore”"
      },
      {
        "type": "text",
        "id": "name-3",
        "label": "Name 3",
        "default": "Krysten Lee"
      }
    ],
    "presets": [
	    {
        "name": "Staff Picks",
        "category": "Custom",
        "settings": {}
      }
    ]
  }
{% endschema %}
