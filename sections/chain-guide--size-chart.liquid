    <script>
      var options = {
        cellAlign: 'left',
        contain: true,
        imagesLoaded: true,
        wrapAround: true
      };

      var carouselCable = $('.carousel.carousel-cable').flickity(options),
          carouselBall = $('.carousel.carousel-ball').flickity(options),
          carouselRolo = $('.carousel.carousel-rolo').flickity(options),
          carouselBox = $('.carousel.carousel-box').flickity(options),
          carouselInfinity = $('.carousel.carousel-infinity').flickity(options),
          carouselPaperclip = $('.carousel.carousel-paperclip').flickity(options),
          carouselHerringbone = $('.carousel.carousel-herringbone').flickity(options);

      $('span.option').click(function() {
        var type = $(this).text().toLowerCase();

        $('div.chart-wrapper').hide();
        $(`#chart-${type}`).show();
        $('span.option').removeClass('selected');
        $(this).addClass('selected');

        if(type == 'cable') {
          carouselCable.flickity('resize');
        } else if(type == 'ball') {
          carouselBall.flickity('resize');
        } else if(type == 'rolo') {
          carouselRolo.flickity('resize');
        } else if(type == 'box') {
          carouselBox.flickity('resize');
        } else if(type == 'infinity') {
          carouselInfinity.flickity('resize');
        } else if(type == 'paperclip') {
          carouselPaperclip.flickity('resize');
        } else if(type == 'herringbone') {
          carouselHerringbone.flickity('resize');
        }
      })

      $('#chart-picker').on('change', function() {
        var type = $(this).val();

        $('div.chart-wrapper').hide();
        $(`#chart-${type}`).show();

        if(type == 'cable') {
          carouselCable.flickity('resize');
        } else if(type == 'ball') {
          carouselBall.flickity('resize');
        } else if(type == 'rolo') {
          carouselRolo.flickity('resize');
        } else if(type == 'box') {
          carouselBox.flickity('resize');
        } else if(type == 'infinity') {
          carouselInfinity.flickity('resize');
        } else if(type == 'paperclip') {
          carouselPaperclip.flickity('resize');
        } else if(type == 'herringbone') {
          carouselHerringbone.flickity('resize');
        }
      });

      tippy('#tooltip-1', {
        content: '<h3>16" Thick Cable</h3><div>Super Strong, great for kids</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-2', {
        content: '<h3>16"-18" Adjustable Cable</h3><div>Our most popular and perfect for gifting</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-3', {
        content: '<h3>24" Cable</h3><div>Great for every day wear as 24" can be slipped over the head without unclasping</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-4', {
        content: '<h3>24" Thick Cable</h3><div>Popular with men or for a bolder look</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-5', {
        content: '<h3>30" Thick Cable</h3><div>Also popular with men or for a bolder look</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-6', {
        content: '<h3>16"-18" Adjustable Ball</h3><div>Our most popular and perfect for gifting</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-7', {
        content: '<h3>24" Ball</h3><div>Great for every day wear as 24" can be slipped over the head without unclasping</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-8', {
        content: '<h3>24" Heavy Ball</h3><div>Popular with men or for a bolder look</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-9', {
        content: '<h3>24" Box</h3><div>Popular with men or for a bolder look</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-10', {
        content: '<h3>20" Paperclip</h3><div>Great for layering</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      tippy('#tooltip-11', {
        content: '<h3>{{ settings.chart-7-row-2-text-1 }}</h3><div>{{ settings.chart-7-row-2-text-tt }}</div>',
        allowHTML: true,
        theme: 'light',
        placement: 'top-start',
      });

      $('button.show-chart').click(function() {
        var type = $(this).data('type');

        if(!$(this).hasClass('opened')) {
          $(this).addClass('opened');
          $(this).text('Hide Size Chart');
          $(`table.${type}`).slideDown();
        } else {
          $(this).removeClass('opened')
          $(this).text('Show Size Chart')
          $(`table.${type}`).slideUp();
        }
      })

      $('span.swatch-outer').click(function() {
        var type = $(this).data('type'),
            chart = $(this).data('chart');

        $(`div#chart-${chart} table td.rxs`).hide();
        $(`div#chart-${chart} table td.rxs.${type}`).show();
      })
    </script>
  </section>
{% endif %}

