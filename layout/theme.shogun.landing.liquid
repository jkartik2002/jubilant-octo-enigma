          {% assign stock = 'low stock' %}
        {% else %}
          {% assign stock = 'out of stock' %}
        {% endif %}
        dataLayer.push({ ecommerce: null });  // Clear the previous ecommerce object.
        dataLayer.push({
          event: 'gtmEvent',
          eventCategory: 'inventory',
          eventAction: '{{ stock }}',
          eventLabel: '{{ product.title }}',
          inventoryOnHand: {{ product.selected_or_first_available_variant.inventory_quantity }},
          productId: {{ product.selected_or_first_available_variant.id }}
        })
      </script>
