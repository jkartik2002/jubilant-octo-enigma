    <script defer="defer">
      let productsArray = [];
      var variantQuantity = [];
      var productCustomFieldsStockMSG = [];
      // var productDiscountMSG = [];
      var tagString = "";
      let productTags = [];
      {% if product.metafields.custom_fields["stock_status_information"] != blank %}
        productCustomFieldsStockMSG[{{ product.id }}] = {{ product.metafields.custom_fields["stock_status_information"] | json }};
      {% endif %}
      {% comment %}
      {% if product.metafields.custom.discount_message != blank %}
      	productDiscountMSG[{{ product.id }}] = {{ product.metafields.custom.discount_message | json }};
      {% endif %}
      {% endcomment %}
      var productsData = {{ product.variants | json }};
      {% for tag in product.tags %}
        var shopifyTags = "{{ tag }}";
        var tagString = tagString + shopifyTags{% unless forloop.last %} + ", "{% endunless %};
      {% endfor %}
      tagString.split(", ").forEach((tag) => {
        if(tag.includes("stock-manual")){
          var targetElement = document.querySelector("#product-form-pdp form [data-cc-animate]");
          if (targetElement) {
              var config = { subtree: true, childList: true, attributes: true };
              var observer = new MutationObserver(function (mutations) {
                  mutations.forEach(function (mutation) {
                      if (mutation.target.classList.contains('stocklabel-active')) {
                          mutation.target.classList.remove('stocklabel-active');
                          observer.disconnect();
                      }
                  });
              });
              observer.observe(targetElement, config);
          }
        }
      });
      {% for variant in product.variants %}
        variantQuantity[{{ variant.id }}] = "{{ variant.inventory_quantity }}";
        var deliveryDate = "{{ variant.metafields.custom.estimated_date }}";
        productsArray[{{ variant.id }}] = "{{ variant.metafields.custom.estimated_date }}";
      {% endfor %}
      if (variantQuantity[{{ product.selected_or_first_available_variant.id }}] <= 0) {
        var targetElement = document.querySelector("#product-form-pdp form [data-cc-animate]");
        if (targetElement) {
            var config = { subtree: true, childList: true, attributes: true };
            var observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    if (mutation.target.classList.contains('stocklabel-active')) {
                        mutation.target.classList.remove('stocklabel-active');
                        observer.disconnect();
                    }
                });
            });
            observer.observe(targetElement, config);
        }
      }
    </script>
  {% endif %}
