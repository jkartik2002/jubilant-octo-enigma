              document.querySelectorAll(".mu-item-quantity.mu-flex.mu-items-stretch.notranslate").forEach((e) => {
                  if (!e.classList.contains("align-text-center")) {
                    e.classList.add("align-text-center");
                  }
              });
    
            }
        });
    }).observe(document.body, {
        childList: true,
        subtree: true 
    });
</script>
