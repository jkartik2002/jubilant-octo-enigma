    {% if template.name == 'product' %}
      <script defer="defer">
        dataLayer.push({ ecommerce: null });  // Clear the previous ecommerce object.
        dataLayer.push({
          'ecommerce': {
            'detail': {
              {% if product.collections.size > 0 %}
                'actionField': {'list': '{{ product.collections[0].title }}'},    // 'detail' actions have an optional list property.
              {% endif %}
              'products': [{
                'name': '{{ product.title }}',         // Name or ID is required.
                'id': '{{ product.id }}',
                'price': '{{ product.price | money_without_currency }}',
                'brand': '{{ shop.name }}',
                'category': '{{ product.type }}',
                'variant': '{{ product.first_available_variant.title }}'
              }]
            }
          }
        });

        {% if product.selected_or_first_available_variant.inventory_quantity > 10 or product.selected_or_first_available_variant.inventory_policy == 'continue' %}
          {% assign stock = 'in stock' %}
        {% elsif product.selected_or_first_available_variant.inventory_quantity > 0 %}
          {% assign stock = 'low stock' %}
        {% else %}
          {% assign stock = 'out of stock' %}
        {% endif %}
        dataLayer.push({ ecommerce: null });  // Clear the previous ecommerce object.
        dataLayer.push({
          event: 'gtmEvent',
          eventCategory: 'inventory',
          eventAction: '{{ stock }}',
          eventLabel: '{{ product.title }}',
          inventoryOnHand: {{ product.selected_or_first_available_variant.inventory_quantity }},
          productId: {{ product.selected_or_first_available_variant.id }}
        })
      </script>
    {% elsif template.name == 'collection' %}
      <script defer="defer">
        dataLayer.push({ ecommerce: null });  // Clear the previous ecommerce object.
        dataLayer.push({
          'ecommerce': {
            'currencyCode': '{{ shop.currency }}',
            'impressions': [
              {% for product in collection.products %}
                {
                  'name': '{{ product.title }}',
                  'id': '{{ product.id }}',
                  'price': '{{ product.price | money_without_currency }}',
                  'brand': '{{ shop.name }}',
                  'category': '{{ collection.title }}',
                  'variant': '{{ product.first_available_variant.title }}',
                  'list': '{{ collection.title }}',
                  'position': 1
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }
        });
      </script>
    {% endif %}

